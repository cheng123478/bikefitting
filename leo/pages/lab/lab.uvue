<template>
	<view class="lab-page">
		<scroll-view class="lab-scroll" scroll-y="true" :show-scrollbar="false" :style="scrollStyle">
			<view class="lab-shell">
				<view class="lab-hero" :style="headerStyle">
					<view class="lab-hero-glow lab-hero-glow-left"></view>
					<view class="lab-hero-glow lab-hero-glow-right"></view>
					<view class="lab-hero-grid"></view>

					<view class="lab-hero-top">
						<view>
							<text class="lab-kicker">DIAGNOSTIC COMMAND</text>
							<text class="lab-title">BIKE FIT 实验室</text>
							<text class="lab-subtitle">从身体、车辆和动态姿态三个维度，建立更完整的骑行调适闭环。</text>
						</view>
						<view class="lab-status">
							<view class="status-dot"></view>
							<text class="status-text">系统就绪</text>
						</view>
					</view>

					<view class="lab-summary-board">
						<view class="summary-card">
							<text class="summary-label">柔韧性评分</text>
							<text class="summary-value">{{ hasBodyProfile ? flexibilityScore : '--' }}</text>
							<text class="summary-note">身体基础</text>
						</view>
						<view class="summary-card">
							<text class="summary-label">在役单车</text>
							<text class="summary-value">{{ bikeCount }}</text>
							<text class="summary-note">车库资产</text>
						</view>
						<view class="summary-card">
							<text class="summary-label">历史报告</text>
							<text class="summary-value">{{ reportCount }}</text>
							<text class="summary-note">可回溯记录</text>
						</view>
					</view>
				</view>

				<view class="mission-card app-soft-card">
					<view class="mission-copy">
						<text class="mission-kicker">MISSION CONTROL</text>
						<text class="mission-title">先做评估，再做调适</text>
						<text class="mission-desc">先用身体图谱建立基线，再进入静态或动态诊断，最后把单车设定沉淀进车库和报告。</text>
					</view>
					<view class="mission-action" @click="goToBodyProfile">
						<text class="mission-action-text">{{ hasBodyProfile ? '查看图谱' : '录入图谱' }}</text>
					</view>
				</view>

				<view class="bike-selector-wrap">
					<view class="selector-head">
						<view>
							<text class="selector-kicker">ANALYSIS TARGET</text>
							<text class="selector-title">分析选择车辆</text>
						</view>
						<view class="selector-manage" @click="goToGarage">
							<text class="selector-manage-text">车库</text>
						</view>
					</view>

					<view v-if="bikeList.length > 0" class="bike-carousel-shell">
						<view
							v-if="bikeList.length > 2"
							class="bike-select-card stack-card stack-card-third"
							:style="getThirdStackStyle()"
						>
							<view class="bike-photo-stage">
								<image
									v-if="thirdStackBike.displayImageUrl.length > 0"
									class="bike-select-image"
									:src="thirdStackBike.displayImageUrl"
									mode="aspectFit"
								/>
								<view v-else class="bike-select-empty">
									<text class="bike-select-empty-text">BIKE</text>
								</view>
							</view>
							<view class="bike-select-info">
								<text class="bike-select-name">{{ getBikeName(thirdStackBike) }}</text>
								<text class="bike-select-meta">{{ getBikeMeta(thirdStackBike) }}</text>
							</view>
						</view>

						<view
							v-if="bikeList.length > 1"
							class="bike-select-card stack-card stack-card-second"
							:style="getSecondStackStyle()"
						>
							<view class="bike-photo-stage">
								<image
									v-if="secondStackBike.displayImageUrl.length > 0"
									class="bike-select-image"
									:src="secondStackBike.displayImageUrl"
									mode="aspectFit"
								/>
								<view v-else class="bike-select-empty">
									<text class="bike-select-empty-text">BIKE</text>
								</view>
							</view>
							<view class="bike-select-info">
								<text class="bike-select-name">{{ getBikeName(secondStackBike) }}</text>
								<text class="bike-select-meta">{{ getBikeMeta(secondStackBike) }}</text>
							</view>
						</view>

						<view
							:class="getTopStackClass()"
							:style="getTopStackStyle()"
							@touchstart="handleStackTouchStart"
							@touchmove="handleStackTouchMove"
							@touchend="handleStackTouchEnd"
							@touchcancel="handleStackTouchCancel"
						>
							<view v-if="bikeList.length > 1" class="bike-stack-edge bike-stack-edge-right" @click.stop="switchStackNext">
								<text class="bike-stack-edge-text">›</text>
							</view>
							<view class="bike-photo-stage">
								<image
									v-if="topStackBike.displayImageUrl.length > 0"
									class="bike-select-image"
									:src="topStackBike.displayImageUrl"
									mode="aspectFit"
								/>
								<view v-else class="bike-select-empty">
									<text class="bike-select-empty-text">BIKE</text>
								</view>
							</view>
							<view class="bike-select-info">
								<text class="bike-select-name">{{ getBikeName(topStackBike) }}</text>
								<text class="bike-select-meta">{{ getBikeMeta(topStackBike) }}</text>
								<view class="bike-select-status">
									<view class="selected-pulse-dot"></view>
									<text class="bike-select-status-text">当前分析车辆</text>
								</view>
							</view>
						</view>

						<view class="selector-counter">
							<text class="selector-counter-text">{{ selectedBikeIndex + 1 }} / {{ bikeList.length }}</text>
						</view>
					</view>

					<view v-else class="bike-selector-empty app-soft-card">
						<view class="bike-selector-empty-icon">
							<text class="bike-selector-empty-icon-text">BIKE</text>
						</view>
						<view class="bike-selector-empty-copy">
							<text class="bike-selector-empty-title">还没有可分析的车辆</text>
							<text class="bike-selector-empty-desc">先把目标单车保存到车库，再进入静态或动态诊断。</text>
						</view>
						<view class="bike-selector-empty-action" @click="goToGarage">
							<text class="bike-selector-empty-action-text">新增</text>
						</view>
					</view>
				</view>

				<view class="section-header">
					<view>
						<text class="section-kicker">PRIMARY ENGINES</text>
						<text class="section-title">诊断引擎</text>
					</view>
				</view>

				<view class="engine-stack">
					<view class="engine-card static-card" @click="goToStatic">
						<view class="engine-head">
							<view class="engine-label-wrap">
								<text class="engine-chip">BASELINE</text>
								<text class="engine-name">静态几何诊断</text>
							</view>
							<view class="engine-history" @click.stop="goToStaticHistory">
								<text class="engine-history-text">历史报告</text>
							</view>
						</view>
						<view class="engine-body">
							<view class="engine-visual">
								<view class="engine-ring"></view>
								<view class="engine-scan"></view>
								<text class="engine-visual-icon">📐</text>
							</view>
							<view class="engine-copy">
								<text class="engine-title">建立骑手与单车的几何基准</text>
								<text class="engine-desc">根据身体图谱和基础设定推导更合理的坐垫高度、前伸和把位方向。</text>
								<view class="engine-foot">
									<text class="engine-foot-label">推荐用于首次调适</text>
									<text class="engine-foot-cta">生成方案 →</text>
								</view>
							</view>
						</view>
					</view>

					<view class="engine-card dynamic-card" @click="goToDynamic">
						<view class="engine-head">
							<view class="engine-label-wrap">
								<text class="engine-chip">VISION</text>
								<text class="engine-name">动态视觉分析</text>
							</view>
							<view class="engine-history" @click.stop="goToDynamicHistory">
								<text class="engine-history-text">历史报告</text>
							</view>
						</view>
						<view class="engine-body">
							<view class="engine-visual soft-blue">
								<text class="engine-visual-icon">📹</text>
							</view>
							<view class="engine-copy">
								<text class="engine-title">观察踩踏节奏与姿态代偿</text>
								<text class="engine-desc">通过 AI 视觉识别追踪膝、髋、肩等关键区域的动态轨迹与姿态变化。</text>
								<view class="engine-foot">
									<text class="engine-foot-label">推荐用于进阶优化</text>
									<text class="engine-foot-cta">开始分析 →</text>
								</view>
							</view>
						</view>
					</view>

					<view class="engine-card live-card" @click="goToRealtime">
						<view class="engine-head">
							<view class="engine-label-wrap">
								<text class="engine-chip">REAL-TIME</text>
								<text class="engine-name">姿态实时监护</text>
							</view>
						</view>
						<view class="engine-body">
							<view class="engine-visual alert">
								<view class="pulse"></view>
								<text class="engine-visual-icon">💓</text>
							</view>
							<view class="engine-copy">
								<text class="engine-title">在训练中持续观察疲劳与代偿</text>
								<text class="engine-desc">更适合与设备联动时做持续监测，目前入口保留中。</text>
								<view class="engine-foot">
									<text class="engine-foot-label">高级能力预留</text>
									<text class="engine-foot-cta">敬请期待</text>
								</view>
							</view>
						</view>
					</view>
				</view>

				<view class="section-header compact">
					<view>
						<text class="section-kicker">ARCHIVE LAYERS</text>
						<text class="section-title">数据沉淀</text>
					</view>
				</view>

				<view class="archive-card app-soft-card" @click="goToArchives">
					<view class="archive-main">
						<view class="archive-icon-wrap">
							<text class="archive-icon">🗂️</text>
						</view>
						<view class="archive-copy">
							<text class="archive-title">诊断档案室</text>
							<text class="archive-desc">集中管理评估记录、报告历史和后续可回溯的数据版本。</text>
						</view>
					</view>
					<text class="archive-link">查看入口 ›</text>
				</view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { computed, ref } from 'vue'
	import { getDynamicFittingCount, getDynamicFittingSessions } from '@/api/dynamicFitting.uts'
	import { getLatestUserBody, getMyGarage } from '@/api/user.uts'
	import { getUserInfo } from '@/store/user.uts'
	import { getAppLayoutMetrics } from '@/utils/layout.uts'
	import { resolveAssetUrl } from '@/utils/url.uts'

	type LabHistoryItem = {
		id : number
		type : string
		icon : string
		title : string
		time : string
		status : number
	}

	type LabBikeCard = {
		id : number
		brand : string | null
		model : string | null
		remark : string | null
		imageUrl : string
		displayImageUrl : string
		bikeType : number | null
		frameSize : string | null
		hasReport : boolean
	}

	const layout = getAppLayoutMetrics()
	const scrollStyle = {
		paddingBottom: layout.tabBarHeight + layout.tabPageBottomSpace + 16 + 'px'
	}
	const headerStyle = {
		paddingTop: layout.statusBarHeight + 26 + 'px'
	}

	const hasBodyProfile = ref(false)
	const flexibilityScore = ref('--')
	const bikeCount = ref(0)
	const reportCount = ref(0)
	const bikeList = ref<LabBikeCard[]>([])
	const selectedBikeIndex = ref(0)
	const selectedBikeId = ref(0)
	const isStackDragging = ref(false)
	const isStackAnimating = ref(false)
	const isStackResetting = ref(false)
	const stackDirection = ref(1)
	const stackMotionId = ref(0)
	const dragLock = ref('')
	const touchStartX = ref(0)
	const touchStartY = ref(0)
	const dragX = ref(0)
	const dragY = ref(0)
	const historyList = ref<LabHistoryItem[]>([])

	const emptyBikeCard : LabBikeCard = {
		id: 0,
		brand: null,
		model: null,
		remark: null,
		imageUrl: '',
		displayImageUrl: '',
		bikeType: null,
		frameSize: null,
		hasReport: false
	}

	function toSafeNumber(value : any | null, fallback : number) : number {
		if (value == null) return fallback
		const parsed = parseFloat(`${value}`)
		return isNaN(parsed) ? fallback : parsed
	}

	function toText(value : any | null) : string {
		return value != null ? `${value}` : ''
	}

	function createAnyArray() : any[] {
		const items : any[] = []
		return items
	}

	function toJsonObject(value : any | null) : UTSJSONObject | null {
		if (value == null) {
			return null
		}
		const jsonText = JSON.stringify(value)
		const parsed = JSON.parse(jsonText)
		return parsed != null ? parsed as UTSJSONObject : null
	}

	function getJsonValue(source : UTSJSONObject | null, key : string) : any | null {
		const current = source
		if (current == null) {
			return null
		}
		const value = current[key]
		return value != null ? value : null
	}

	function getJsonText(source : UTSJSONObject | null, key : string, fallback : string) : string {
		const value = getJsonValue(source, key)
		if (value == null) {
			return fallback
		}
		const text = toText(value)
		return text.length > 0 ? text : fallback
	}

	function getJsonNumber(source : UTSJSONObject | null, key : string, fallback : number) : number {
		const value = getJsonValue(source, key)
		return value != null ? toSafeNumber(value, fallback) : fallback
	}

	function getJsonNullableText(source : UTSJSONObject | null, key : string) : string | null {
		const value = getJsonValue(source, key)
		if (value == null) {
			return null
		}
		const text = toText(value)
		return text.length > 0 ? text : null
	}

	function getJsonArray(source : UTSJSONObject | null, key : string) : any[] {
		const value = getJsonValue(source, key)
		if (value == null) {
			return createAnyArray()
		}
		const jsonText = JSON.stringify(value)
		const parsed = JSON.parse(jsonText)
		return parsed != null ? parsed as any[] : createAnyArray()
	}

	function toAnyArray(value : any | null) : any[] {
		if (value == null) {
			return createAnyArray()
		}
		const jsonText = JSON.stringify(value)
		const parsed = JSON.parse(jsonText)
		return parsed != null ? parsed as any[] : createAnyArray()
	}

	function padNumber(value : number) : string {
		if (value < 10) return `0${value}`
		return `${value}`
	}

	function clampNumber(value : number, min : number, max : number) : number {
		if (value < min) return min
		if (value > max) return max
		return value
	}

	function normalizeBike(raw : any) : LabBikeCard {
		const source = toJsonObject(raw)
		const imageUrl = getJsonText(source, 'imageUrl', '')
		const bikeTypeValue = getJsonValue(source, 'bikeType')
		return {
			id: getJsonNumber(source, 'id', 0),
			brand: getJsonNullableText(source, 'brand'),
			model: getJsonNullableText(source, 'model'),
			remark: getJsonNullableText(source, 'remark'),
			imageUrl: imageUrl,
			displayImageUrl: resolveAssetUrl(imageUrl),
			bikeType: bikeTypeValue != null ? toSafeNumber(bikeTypeValue, 0) : null,
			frameSize: getJsonNullableText(source, 'frameSize'),
			hasReport: getJsonValue(source, 'hasReport') == true
		}
	}

	function syncSelectedBikeByIndex(index : number) {
		if (bikeList.value.length == 0) {
			selectedBikeIndex.value = 0
			selectedBikeId.value = 0
			return
		}
		let nextIndex = index
		if (nextIndex < 0) {
			nextIndex = bikeList.value.length - 1
		}
		if (nextIndex >= bikeList.value.length) {
			nextIndex = 0
		}
		selectedBikeIndex.value = nextIndex
		selectedBikeId.value = bikeList.value[nextIndex].id
	}

	function restoreSelectedBikeIndex() {
		if (bikeList.value.length == 0) {
			syncSelectedBikeByIndex(0)
			return
		}
		if (selectedBikeId.value > 0) {
			for (let i = 0; i < bikeList.value.length; i++) {
				if (bikeList.value[i].id == selectedBikeId.value) {
					syncSelectedBikeByIndex(i)
					return
				}
			}
		}
		syncSelectedBikeByIndex(0)
	}

	function ensureLoggedIn() : boolean {
		const user = getUserInfo()
		return user != null && user.phone != null && user.phone.length > 0
	}

	async function loadBodyProfile() {
		try {
			const data = await getLatestUserBody()
			const bodyData = toJsonObject(data)
			if (getJsonValue(bodyData, 'id') != null) {
				hasBodyProfile.value = true
				const flexibilityScoreValue = getJsonValue(bodyData, 'flexibilityScore')
				const flexibilityValue = getJsonValue(bodyData, 'flexibility')
				if (flexibilityScoreValue != null) {
					flexibilityScore.value = toText(flexibilityScoreValue)
				} else if (flexibilityValue != null) {
					flexibilityScore.value = toText(flexibilityValue)
				} else {
					flexibilityScore.value = '--'
				}
			} else {
				hasBodyProfile.value = false
				flexibilityScore.value = '--'
			}
		} catch (e) {
			console.error('[Lab] body profile load failed', e)
			hasBodyProfile.value = false
			flexibilityScore.value = '--'
		}
	}

	async function loadBikeCount() {
		try {
			const data = await getMyGarage()
			let list = toAnyArray(data)
			if (list.length == 0) {
				const dataObject = toJsonObject(data)
				list = getJsonArray(dataObject, 'list')
			}
			const normalized : LabBikeCard[] = []
			for (let i = 0; i < list.length; i++) {
				const bike = normalizeBike(list[i])
				if (bike.id > 0) {
					normalized.push(bike)
				}
			}
			bikeList.value = normalized
			bikeCount.value = normalized.length
			restoreSelectedBikeIndex()
		} catch (e) {
			console.error('[Lab] bike load failed', e)
			bikeList.value = []
			bikeCount.value = 0
			selectedBikeIndex.value = 0
			selectedBikeId.value = 0
		}
	}

	function formatHistoryTime(source : string) : string {
		if (source.length == 0) return '--'
		const date = new Date(source)
		if (isNaN(date.getTime())) {
			return source.replace('T', ' ').substring(0, 16)
		}
		const year = `${date.getFullYear()}`
		const month = padNumber(date.getMonth() + 1)
		const day = padNumber(date.getDate())
		const hour = padNumber(date.getHours())
		const minute = padNumber(date.getMinutes())
		return `${year}-${month}-${day} ${hour}:${minute}`
	}

	async function loadDynamicSummary() {
		try {
			const countData = await getDynamicFittingCount()
			if (typeof countData === 'number' || typeof countData === 'string') {
				reportCount.value = toSafeNumber(countData, 0)
			} else {
				const countObject = toJsonObject(countData)
				const countValue = getJsonValue(countObject, 'count')
				reportCount.value = countValue != null ? toSafeNumber(countValue, 0) : toSafeNumber(countData, 0)
			}
		} catch (e) {
			console.error('[Lab] dynamic count load failed', e)
			reportCount.value = 0
		}

		try {
			const data = await getDynamicFittingSessions(1, 3)
			const dataObject = toJsonObject(data)
			const list = getJsonArray(dataObject, 'content')
			const nextList : LabHistoryItem[] = []
			for (let i = 0; i < list.length; i++) {
				const item = toJsonObject(list[i])
				const status = getJsonNumber(item, 'status', 1)
				const sessionTime = getJsonText(item, 'sessionTime', '')
				const createTime = getJsonText(item, 'createTime', '')
				const timeText = sessionTime.length > 0 ? sessionTime : createTime
				nextList.push({
					id: getJsonNumber(item, 'id', 0),
					type: 'dynamic',
					icon: '📹',
					title: status == 2 ? '动态视觉分析报告' : status == 3 ? '动态视觉分析失败' : '动态视觉分析进行中',
					time: formatHistoryTime(timeText),
					status: status
				})
			}
			historyList.value = nextList
		} catch (e) {
			console.error('[Lab] recent dynamic history load failed', e)
			historyList.value = []
		}
	}

	async function initLabData() {
		if (!ensureLoggedIn()) {
			hasBodyProfile.value = false
			flexibilityScore.value = '--'
			bikeCount.value = 0
			reportCount.value = 0
			bikeList.value = []
			selectedBikeIndex.value = 0
			selectedBikeId.value = 0
			historyList.value = []
			return
		}

		await loadBodyProfile()
		await loadBikeCount()
		await loadDynamicSummary()
	}

	function getVisibleBike(offset : number) : LabBikeCard {
		if (bikeList.value.length == 0) {
			return emptyBikeCard
		}
		let index = selectedBikeIndex.value + offset
		while (index < 0) {
			index += bikeList.value.length
		}
		while (index >= bikeList.value.length) {
			index -= bikeList.value.length
		}
		return bikeList.value[index]
	}

	function getStackDirection() : number {
		return stackDirection.value
	}

	function getSecondStackOffset() : number {
		return getStackDirection()
	}

	function getThirdStackOffset() : number {
		return getStackDirection() * 2
	}

	const topStackBike = computed(() : LabBikeCard => getVisibleBike(0))
	const secondStackBike = computed(() : LabBikeCard => getVisibleBike(getSecondStackOffset()))
	const thirdStackBike = computed(() : LabBikeCard => getVisibleBike(getThirdStackOffset()))

	function getDragProgress() : number {
		return clampNumber(Math.abs(dragX.value) / 110.0, 0, 1)
	}

	function getTopStackClass() : string {
		if (isStackResetting.value) {
			return 'bike-select-card stack-card stack-card-top stack-card-resetting'
		}
		if (isStackDragging.value) {
			return 'bike-select-card stack-card stack-card-top stack-card-dragging'
		}
		if (isStackAnimating.value) {
			return 'bike-select-card stack-card stack-card-top stack-card-animating'
		}
		return 'bike-select-card stack-card stack-card-top'
	}

	function getTopStackStyle() : any {
		const angle = isStackAnimating.value ? 0 : clampNumber(dragX.value / 26.0, -7, 7)
		const lift = Math.abs(dragX.value) > 12 ? -2 : 0
		return {
			transform: `translateX(${dragX.value}px) translateY(${dragY.value + lift}px) rotate(${angle}deg) scale(1)`,
			opacity: 1
		}
	}

	function getSecondStackStyle() : any {
		const progress = getDragProgress()
		const direction = getStackDirection()
		const x = direction * 10 * (1 - progress)
		const y = 16 * (1 - progress)
		const scale = 0.94 + progress * 0.06
		const angle = direction * 3 * (1 - progress)
		const opacity = 0.78 + progress * 0.22
		return {
			transform: `translateX(${x}px) translateY(${y}px) rotate(${angle}deg) scale(${scale})`,
			opacity: opacity
		}
	}

	function getThirdStackStyle() : any {
		const progress = getDragProgress()
		const direction = getStackDirection()
		const x = direction * -8 + direction * progress * 5
		const y = 30 - progress * 12
		const scale = 0.89 + progress * 0.04
		const angle = direction * -4 + direction * progress * 2
		const opacity = 0.5 + progress * 0.12
		return {
			transform: `translateX(${x}px) translateY(${y}px) rotate(${angle}deg) scale(${scale})`,
			opacity: opacity
		}
	}

	function hasTouchPoint(event : TouchEvent) : boolean {
		return event.touches.length > 0 || event.changedTouches.length > 0
	}

	function getTouchClientX(event : TouchEvent, fallback : number) : number {
		if (event.touches.length > 0) {
			return event.touches[0].clientX
		}
		if (event.changedTouches.length > 0) {
			return event.changedTouches[0].clientX
		}
		return fallback
	}

	function getTouchClientY(event : TouchEvent, fallback : number) : number {
		if (event.touches.length > 0) {
			return event.touches[0].clientY
		}
		if (event.changedTouches.length > 0) {
			return event.changedTouches[0].clientY
		}
		return fallback
	}

	function resetStackDrag() {
		stackMotionId.value = stackMotionId.value + 1
		isStackDragging.value = false
		isStackAnimating.value = false
		isStackResetting.value = false
		stackDirection.value = 1
		dragLock.value = ''
		dragX.value = 0
		dragY.value = 0
	}

	function finishStackSwipe(direction : number, motionId : number) {
		if (motionId != stackMotionId.value) {
			return
		}
		const offset = direction > 0 ? 1 : -1
		isStackResetting.value = true
		isStackAnimating.value = false
		isStackDragging.value = false
		syncSelectedBikeByIndex(selectedBikeIndex.value + offset)
		stackDirection.value = 1
		dragLock.value = ''
		dragX.value = 0
		dragY.value = 0
		setTimeout(() => {
			if (motionId != stackMotionId.value) {
				return
			}
			isStackResetting.value = false
		}, 40)
	}

	function animateStackSwipe(direction : number) {
		stackMotionId.value = stackMotionId.value + 1
		const motionId = stackMotionId.value
		isStackDragging.value = false
		isStackResetting.value = false
		isStackAnimating.value = true
		stackDirection.value = direction > 0 ? 1 : -1
		dragX.value = direction * 620
		dragY.value = direction > 0 ? 10 : -10
		setTimeout(() => {
			finishStackSwipe(direction, motionId)
		}, 230)
	}

	function switchStackNext() {
		if (bikeList.value.length <= 1 || isStackAnimating.value || isStackResetting.value) {
			return
		}
		animateStackSwipe(1)
	}

	function handleStackTouchStart(event : TouchEvent) {
		if (bikeList.value.length <= 1 || isStackAnimating.value || isStackResetting.value) {
			return
		}
		if (!hasTouchPoint(event)) {
			return
		}
		touchStartX.value = getTouchClientX(event, 0)
		touchStartY.value = getTouchClientY(event, 0)
		isStackDragging.value = true
		dragLock.value = ''
		dragX.value = 0
		dragY.value = 0
	}

	function handleStackTouchMove(event : TouchEvent) {
		if (!isStackDragging.value || isStackAnimating.value) {
			return
		}
		if (!hasTouchPoint(event)) {
			return
		}
		const currentX = getTouchClientX(event, touchStartX.value)
		const currentY = getTouchClientY(event, touchStartY.value)
		const dx = currentX - touchStartX.value
		const dy = currentY - touchStartY.value
		const absX = Math.abs(dx)
		const absY = Math.abs(dy)

		if (dragLock.value.length == 0) {
			if (absY > 12 && absY > absX * 1.25) {
				dragLock.value = 'vertical'
				return
			}
			if (absX > 8 && absX > absY) {
				dragLock.value = 'horizontal'
				stackDirection.value = 1
			}
		}

		if (dragLock.value != 'horizontal') {
			return
		}

		event.stopPropagation()
		event.preventDefault()
		stackDirection.value = 1
		dragX.value = clampNumber(dx, -26, 230)
		dragY.value = clampNumber(dy, -14, 14)
	}

	function handleStackTouchEnd() {
		if (!isStackDragging.value) {
			return
		}
		if (dragLock.value == 'horizontal' && dragX.value > 72 && bikeList.value.length > 1) {
			animateStackSwipe(1)
			return
		}
		resetStackDrag()
	}

	function handleStackTouchCancel() {
		if (isStackAnimating.value || isStackResetting.value) {
			return
		}
		if (isStackDragging.value) {
			resetStackDrag()
		}
	}

	function getBikeName(bike : LabBikeCard) : string {
		const brand = bike.brand != null ? bike.brand : ''
		const model = bike.model != null ? bike.model : ''
		const fullName = `${brand} ${model}`.trim()
		return fullName.length > 0 ? fullName : '未命名单车'
	}

	function getBikeTypeLabel(type : number | null) : string {
		if (type == 1) return '公路'
		if (type == 2) return '山地'
		if (type == 3) return 'Gravel'
		if (type == 4) return '城市'
		if (type == 5) return 'TT'
		return '单车'
	}

	function getBikeMeta(bike : LabBikeCard) : string {
		const parts : string[] = []
		if (bike.frameSize != null && bike.frameSize.length > 0) {
			parts.push(bike.frameSize + ' 尺码')
		}
		parts.push(getBikeTypeLabel(bike.bikeType))
		if (bike.hasReport) {
			parts.push('已有报告')
		}
		return parts.join(' · ')
	}

	function goToStatic() {
		if (!hasBodyProfile.value) {
			uni.showToast({ title: '请先完成身体图谱录入', icon: 'none' })
			return
		}
		if (selectedBikeId.value <= 0) {
			uni.showToast({ title: '请先选择一辆分析车辆', icon: 'none' })
			return
		}
		uni.showToast({ title: '功能开发中', icon: 'none' })
	}

	function goToStaticHistory() {
		uni.showToast({ title: '功能开发中', icon: 'none' })
	}

	function goToDynamic() {
		if (!ensureLoggedIn()) {
			uni.navigateTo({ url: '/pages/login/login' })
			return
		}
		if (!hasBodyProfile.value) {
			uni.showToast({ title: '请先完成身体图谱录入', icon: 'none' })
			return
		}
		if (selectedBikeId.value <= 0) {
			uni.showToast({ title: '请先选择一辆分析车辆', icon: 'none' })
			return
		}
		uni.navigateTo({ url: `/pages/dynamicSession/dynamicSession?bikeId=${selectedBikeId.value}` })
	}

	function goToDynamicHistory() {
		if (!ensureLoggedIn()) {
			uni.navigateTo({ url: '/pages/login/login' })
			return
		}
		uni.navigateTo({ url: '/pages/dynamicHistory/dynamicHistory' })
	}

	function goToRealtime() {
		uni.showToast({ title: '功能开发中', icon: 'none' })
	}

	function goToBodyProfile() {
		if (!ensureLoggedIn()) {
			uni.navigateTo({ url: '/pages/login/login' })
			return
		}
		uni.navigateTo({ url: '/pages/bodyProfile/bodyProfile' })
	}

	function goToGarage() {
		if (!ensureLoggedIn()) {
			uni.navigateTo({ url: '/pages/login/login' })
			return
		}
		uni.navigateTo({ url: '/pages/garage/garage' })
	}

	function goToArchives() {
		goToDynamicHistory()
	}

	function viewHistory(item : LabHistoryItem) {
		if (item.status == 2) {
			uni.navigateTo({
				url: `/pages/dynamicReport/dynamicReport?sessionId=${item.id}`
			})
			return
		}

		uni.navigateTo({
			url: `/pages/dynamicSubmitted/dynamicSubmitted?id=${item.id}&status=${item.status}`
		})
	}

	onShow(() => {
		initLabData()
	})
</script>

