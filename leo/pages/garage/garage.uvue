	}

	.bike-type-badge {
		position: absolute;
		top: 24rpx;
		left: 24rpx;
		padding: 10rpx 18rpx;
		border-radius: 999rpx;
		background: rgba(67, 66, 63, 0.88);
	}

	.bike-type-text {
		font-size: 22rpx;
		color: #FFFFFF;
		font-weight: 700;
	}

	.bike-content {
