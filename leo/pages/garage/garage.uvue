	}

	.nav-title {
		position: absolute;
		left: 50%;
		transform: translate(-50%, -50%);
		font-size: 32rpx;
		font-weight: 700;
		color: #2B2A29;
	}

	.nav-right {
		position: absolute;
		right: 24rpx;
		transform: translateY(-50%);
		min-width: 72rpx;
		align-items: flex-end;
	}

	.nav-count {
		font-size: 22rpx;
		color: #7B766B;
	}

	.garage-scroll {
		position: fixed;
		left: 0;
		right: 0;
		bottom: 0;
		box-sizing: border-box;
	}

	.garage-shell {
		padding: 20rpx 32rpx 0;
	}

	.garage-hero {
		padding: 34rpx 30rpx;
		margin-bottom: 24rpx;
	}

	.garage-kicker {
		font-size: 20rpx;
		font-weight: 700;
		color: #8A857A;
		letter-spacing: 4rpx;
		margin-bottom: 10rpx;
	}

	.garage-title {
		font-size: 50rpx;
		line-height: 1.08;
		font-weight: 700;
		color: #2B2A29;
		margin-bottom: 14rpx;
	}

	.garage-desc {
		font-size: 24rpx;
		line-height: 1.72;
		color: #7B766B;
		margin-bottom: 20rpx;
	}

	.garage-actions {
		flex-direction: row;
		justify-content: flex-end;
	}

	.garage-add-btn {
		height: 76rpx;
		padding: 0 30rpx;
		border-radius: 8px;
		background: #5C6E58;
		align-items: center;
		justify-content: center;
		box-shadow: 0 10rpx 24rpx rgba(74, 93, 72, 0.18);
	}

	.garage-add-text {
		font-size: 26rpx;
		font-weight: 700;
		color: #FFFFFF;
	}

	.loading-wrap {
		padding: 64rpx 36rpx;
		align-items: center;
	}

	.loading-title {
		font-size: 32rpx;
		color: #2B2A29;
		font-weight: 700;
		margin-bottom: 12rpx;
	}

	.loading-desc {
		font-size: 24rpx;
		color: #979184;
	}

	.bike-list {
		padding-bottom: 8rpx;
	}

	.bike-card {
		margin-bottom: 24rpx;
		overflow: hidden;
	}

	.bike-image-wrap {
		position: relative;
		height: 340rpx;
		background: #FFFFFF;
		padding: 28rpx;
	}

	.bike-image {
		width: 100%;
		height: 100%;
	}

	.bike-image-placeholder {
		width: 100%;
		height: 100%;
		align-items: center;
		justify-content: center;
	}

	.bike-image-placeholder-icon {
		font-size: 66rpx;
		margin-bottom: 10rpx;
	}

	.bike-image-placeholder-text {
		font-size: 24rpx;
