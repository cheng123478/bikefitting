<template>
	<view class="garage-page">
		<view class="nav-bar" :style="navBarStyle">
			<view class="back-btn" :style="navBackStyle" @click="goBack">
				<text class="back-icon">‹</text>
			</view>
			<text class="nav-title" :style="navTitleStyle">我的车库</text>
			<view class="nav-right" :style="navRightStyle">
				<text class="nav-count">{{ bikeCountText }}</text>
			</view>
		</view>

		<scroll-view
			class="garage-scroll"
			scroll-y="true"
			:show-scrollbar="false"
			:style="scrollStyle"
			:refresher-enabled="true"
			:refresher-triggered="refreshing"
			@refresherrefresh="handleRefresh"
		>
			<view class="garage-shell">
				<view class="garage-hero app-soft-card">
					<text class="garage-kicker">MOBILE GARAGE</text>
					<text class="garage-title">单车资产总览</text>
					<text class="garage-desc">移动端先聚焦展示你已录入的单车卡片、关键几何参数和当前设定，方便快速回看。</text>
					<view class="garage-actions">
						<view class="garage-add-btn" @click="goAddBike">
							<text class="garage-add-text">新增单车</text>
						</view>
					</view>
				</view>

				<view v-if="loading" class="loading-wrap app-soft-card">
					<text class="loading-title">正在打开车库...</text>
					<text class="loading-desc">单车数据和图片将从后端实时加载</text>
				</view>

				<view v-else-if="bikeList.length > 0" class="bike-list">
					<view v-for="bike in bikeList" :key="bike.id" class="bike-card app-soft-card">
						<view class="bike-image-wrap">
							<image
								v-if="bike.displayImageUrl.length > 0"
								class="bike-image"
								:src="bike.displayImageUrl"
								mode="aspectFit"
							/>
							<view v-else class="bike-image-placeholder">
								<text class="bike-image-placeholder-icon">🚲</text>
								<text class="bike-image-placeholder-text">暂无车辆图片</text>
							</view>
							<view class="bike-type-badge">
								<text class="bike-type-text">{{ getBikeTypeLabel(bike.bikeType) }}</text>
							</view>
						</view>

						<view class="bike-content">
							<view class="bike-title-row">
								<text class="bike-name">{{ getBikeName(bike) }}</text>
								<text v-if="bike.hasReport" class="report-badge">已诊断</text>
							</view>

							<text v-if="bike.remark" class="bike-remark">{{ bike.remark }}</text>

							<view class="bike-meta-row">
								<text class="bike-meta">{{ bike.brand != null && bike.brand.length > 0 ? bike.brand : '--' }}</text>
								<text class="bike-meta-dot">·</text>
								<text class="bike-meta">{{ bike.frameSize != null && bike.frameSize.length > 0 ? bike.frameSize : '--' }} 尺码</text>
								<text v-if="bike.modelYear" class="bike-meta-dot">·</text>
								<text v-if="bike.modelYear" class="bike-meta">{{ bike.modelYear }}</text>
							</view>

							<view class="metric-grid">
								<view class="metric-item">
									<text class="metric-label">STR</text>
									<text class="metric-value">{{ formatMetric(bike.frameStr, '') }}</text>
								</view>
								<view class="metric-item">
									<text class="metric-label">Reach+</text>
									<text class="metric-value">{{ formatMetric(bike.effectiveReachPlus, 'mm') }}</text>
								</view>
								<view class="metric-item">
									<text class="metric-label">Stack+</text>
									<text class="metric-value">{{ formatMetric(bike.effectiveStackPlus, 'mm') }}</text>
								</view>
								<view class="metric-item">
									<text class="metric-label">曲柄</text>
									<text class="metric-value">{{ formatMetric(bike.crankLength, 'mm') }}</text>
								</view>
							</view>

							<view class="setup-bar">
								<text class="setup-label">当前设定</text>
								<text class="setup-text">{{ getSetupSummary(bike) }}</text>
							</view>

							<view class="card-footer">
								<text class="footer-text">录入时间 {{ formatDate(bike.createTime) }}</text>
								<view class="footer-actions">
									<view class="bike-action" @click="goEditBike(bike.id)">
										<text class="bike-action-text">编辑</text>
									</view>
									<view :class="deletingBikeId == bike.id ? 'bike-action bike-action-danger bike-action-disabled' : 'bike-action bike-action-danger'" @click="confirmDeleteBike(bike)">
										<text class="bike-action-danger-text">{{ deletingBikeId == bike.id ? '删除中' : '删除' }}</text>
									</view>
								</view>
							</view>
						</view>
					</view>
				</view>

				<view v-else class="empty-state app-soft-card">
					<view class="empty-icon-wrap">
						<text class="empty-icon">🚲</text>
					</view>
					<text class="empty-title">车库里还没有单车</text>
					<text class="empty-desc">当前移动端先提供轻量展示能力。等你在其他端录入单车后，这里会自动同步显示。</text>
					<view class="empty-action" @click="goAddBike">
						<text class="empty-action-text">录入第一辆车</text>
					</view>
				</view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { computed, ref } from 'vue'
	import { deleteUserBike, getMyGarage } from '@/api/user.uts'
	import { getAppLayoutMetrics } from '@/utils/layout.uts'
	import { resolveAssetUrl } from '@/utils/url.uts'

	type UserBikeSetupVO = {
		stemLength ?: number | null
		stemAngle ?: number | null
		spacersHeight ?: number | null
		saddleHeight ?: number | null
	}

	type UserBikeCard = {
		id : number
		createTime : string | null
		remark : string | null
		status : number | null
		brand : string | null
		model : string | null
		modelYear : string | null
		imageUrl : string | null
		displayImageUrl : string
		bikeType : number | null
		frameSize : string | null
		crankLength : number | null
		frameStr : number | null
		effectiveStackPlus : number | null
		effectiveReachPlus : number | null
		hasReport : boolean
		currentSetupVO : UserBikeSetupVO | null
	}

	const layout = getAppLayoutMetrics()
	const navContentCenter = layout.statusBarHeight + layout.navBarContentHeight / 2
	const navBarStyle = {
		height: layout.navBarHeight + 'px',
		paddingTop: layout.statusBarHeight + 'px',
		boxSizing: 'border-box'
	}
	const navBackStyle = {
		top: navContentCenter + 'px'
	}
	const navTitleStyle = {
		top: navContentCenter + 'px'
	}
	const navRightStyle = {
		top: navContentCenter + 'px'
	}
	const scrollStyle = {
		top: layout.navBarHeight + 'px',
		paddingBottom: layout.bottomSafeArea + 24 + 'px'
	}

	const loading = ref(true)
	const refreshing = ref(false)
	const deletingBikeId = ref<number | null>(null)
	const bikeList = ref<UserBikeCard[]>([])

	function toSafeNumber(value : any | null, fallback : number) : number {
		if (value == null) return fallback
		const parsed = parseFloat(`${value}`)
		return isNaN(parsed) ? fallback : parsed
	}

	function toText(value : any | null) : string {
		return value != null ? `${value}` : ''
	}

	function toNullableText(value : any | null) : string | null {
		const text = toText(value)
		return text.length > 0 ? text : null
	}

	function createAnyArray() : any[] {
		const items : any[] = []
		return items
	}

	function toJsonObject(value : any | null) : UTSJSONObject | null {
		if (value == null) {
			return null
		}
		const jsonText = JSON.stringify(value)
		const parsed = JSON.parse(jsonText)
		return parsed != null ? parsed as UTSJSONObject : null
	}

	function getJsonValue(source : UTSJSONObject | null, key : string) : any | null {
		const current = source
		if (current == null) {
			return null
		}
		const value = current[key]
		return value != null ? value : null
	}

	function getJsonText(source : UTSJSONObject | null, key : string, fallback : string) : string {
		const value = getJsonValue(source, key)
		if (value == null) {
			return fallback
		}
		const text = toText(value)
		return text.length > 0 ? text : fallback
	}

	function getJsonNullableText(source : UTSJSONObject | null, key : string) : string | null {
		return toNullableText(getJsonValue(source, key))
	}

	function getJsonNumber(source : UTSJSONObject | null, key : string, fallback : number) : number {
		const value = getJsonValue(source, key)
		return value != null ? toSafeNumber(value, fallback) : fallback
	}

	function getJsonArray(value : any | null) : any[] {
		if (value == null) {
			return createAnyArray()
		}
		const jsonText = JSON.stringify(value)
		const parsed = JSON.parse(jsonText)
		return parsed != null ? parsed as any[] : createAnyArray()
	}

	function toBikeSetup(value : any | null) : UserBikeSetupVO | null {
		if (value == null) {
			return null
		}
		const source = toJsonObject(value)
		if (source == null) {
			return null
		}
		const stemLengthValue = getJsonValue(source, 'stemLength')
		const stemAngleValue = getJsonValue(source, 'stemAngle')
		const spacersHeightValue = getJsonValue(source, 'spacersHeight')
		const saddleHeightValue = getJsonValue(source, 'saddleHeight')
		return {
			stemLength: stemLengthValue != null ? toSafeNumber(stemLengthValue, 0) : null,
			stemAngle: stemAngleValue != null ? toSafeNumber(stemAngleValue, 0) : null,
			spacersHeight: spacersHeightValue != null ? toSafeNumber(spacersHeightValue, 0) : null,
			saddleHeight: saddleHeightValue != null ? toSafeNumber(saddleHeightValue, 0) : null
		}
	}

	function padNumber(value : number) : string {
		if (value < 10) return `0${value}`
		return `${value}`
	}

	const bikeCountText = computed(() : string => {
		return bikeList.value.length > 0 ? `${bikeList.value.length} 辆` : ''
	})

	function normalizeBike(raw : any) : UserBikeCard {
		const source = toJsonObject(raw)
		const imageUrl = getJsonText(source, 'imageUrl', '')
		const currentSetup = toBikeSetup(getJsonValue(source, 'currentSetupVO'))
		const statusValue = getJsonValue(source, 'status')
		const bikeTypeValue = getJsonValue(source, 'bikeType')
		const crankLengthValue = getJsonValue(source, 'crankLength')
		const frameStrValue = getJsonValue(source, 'frameStr')
		const effectiveStackPlusValue = getJsonValue(source, 'effectiveStackPlus')
		const effectiveReachPlusValue = getJsonValue(source, 'effectiveReachPlus')

		return {
			id: getJsonNumber(source, 'id', 0),
			createTime: getJsonNullableText(source, 'createTime'),
			remark: getJsonNullableText(source, 'remark'),
			status: statusValue != null ? toSafeNumber(statusValue, 0) : null,
			brand: getJsonNullableText(source, 'brand'),
			model: getJsonNullableText(source, 'model'),
			modelYear: getJsonNullableText(source, 'modelYear'),
			imageUrl: imageUrl,
			displayImageUrl: resolveAssetUrl(imageUrl),
			bikeType: bikeTypeValue != null ? toSafeNumber(bikeTypeValue, 0) : null,
			frameSize: getJsonNullableText(source, 'frameSize'),
			crankLength: crankLengthValue != null ? toSafeNumber(crankLengthValue, 0) : null,
			frameStr: frameStrValue != null ? toSafeNumber(frameStrValue, 0) : null,
			effectiveStackPlus: effectiveStackPlusValue != null ? toSafeNumber(effectiveStackPlusValue, 0) : null,
			effectiveReachPlus: effectiveReachPlusValue != null ? toSafeNumber(effectiveReachPlusValue, 0) : null,
			hasReport: getJsonValue(source, 'hasReport') == true,
			currentSetupVO: currentSetup
		}
	}

	async function loadGarageData(showPullRefresh : boolean = false) {
		if (!showPullRefresh) {
			loading.value = true
		}
		try {
			const data = await getMyGarage()
			const list = getJsonArray(data)
			const normalized : UserBikeCard[] = []
			for (let i = 0; i < list.length; i++) {
				normalized.push(normalizeBike(list[i]))
			}
			bikeList.value = normalized
		} catch (e) {
			console.error('[Garage] load failed', e)
			uni.showToast({
				title: '加载车库失败',
				icon: 'none'
			})
		} finally {
			loading.value = false
			refreshing.value = false
		}
	}

	function handleRefresh() {
		refreshing.value = true
		loadGarageData(true)
	}

	function goAddBike() {
		uni.navigateTo({
			url: '/pages/garageAdd/garageAdd'
		})
	}

	function goEditBike(id : number) {
		if (id <= 0) {
			uni.showToast({
				title: '单车 ID 异常，无法编辑',
				icon: 'none'
			})
			return
		}
		uni.navigateTo({
			url: '/pages/garageAdd/garageAdd?id=' + id
		})
	}

	async function deleteBikeById(id : number) {
		if (deletingBikeId.value != null) {
			return
		}
		try {
			deletingBikeId.value = id
			await deleteUserBike(id)
			uni.showToast({
				title: '单车已删除',
				icon: 'success'
			})
			loadGarageData(true)
		} catch (e) {
			console.error('[Garage] delete failed', e)
			uni.showToast({
				title: '删除失败，请稍后重试',
				icon: 'none'
			})
		} finally {
			deletingBikeId.value = null
		}
	}

	function confirmDeleteBike(bike : UserBikeCard) {
		if (deletingBikeId.value != null) {
			return
		}
		if (bike.id <= 0) {
			uni.showToast({
				title: '单车 ID 异常，无法删除',
				icon: 'none'
			})
			return
		}
		const brand = bike.brand != null ? bike.brand : ''
		const model = bike.model != null ? bike.model : ''
		const bikeName = `${brand} ${model}`.trim().length > 0 ? `${brand} ${model}`.trim() : '这辆单车'
		uni.showModal({
			title: '删除单车',
			content: '确定删除“' + bikeName + '”吗？删除后不会出现在车库列表中。',
			confirmText: '删除',
			confirmColor: '#B94747',
			cancelText: '取消',
			success: (res : any) => {
				const result = toJsonObject(res)
				if (getJsonValue(result, 'confirm') == true) {
					deleteBikeById(bike.id)
				}
			}
		})
	}

	function goBack() {
		const pages = getCurrentPages()
		if (pages.length > 1) {
			uni.navigateBack({
				delta: 1,
				fail: () => {
					uni.switchTab({ url: '/pages/profile/profile' })
				}
			})
		} else {
			uni.switchTab({ url: '/pages/profile/profile' })
		}
	}

	function getBikeName(bike : UserBikeCard) : string {
		const brand = bike.brand != null ? bike.brand : ''
		const model = bike.model != null ? bike.model : ''
		const fullName = `${brand} ${model}`.trim()
		return fullName.length > 0 ? fullName : '未命名单车'
	}

	function getBikeTypeLabel(type : number | null) : string {
		if (type == 1) return '公路'
		if (type == 2) return '山地'
		if (type == 3) return 'Gravel'
		if (type == 4) return '城市'
		if (type == 5) return 'TT'
		return '单车'
	}

	function formatMetric(value : number | null, unit : string) : string {
		if (value == null) return '--'
		const text = Number.isInteger(value) ? `${value}` : value.toFixed(1)
		return unit.length > 0 ? `${text} ${unit}` : text
	}

	function getSetupSummary(bike : UserBikeCard) : string {
		const setup = bike.currentSetupVO
		if (setup == null) return '暂未同步详细设定'

		const parts : string[] = []
		if (setup.stemLength != null) {
			parts.push(`把立 ${setup.stemLength}mm`)
		}
		if (setup.spacersHeight != null) {
			parts.push(`垫圈 ${setup.spacersHeight}mm`)
		}
		if (setup.saddleHeight != null) {
			parts.push(`座高 ${setup.saddleHeight}mm`)
		}
		if (parts.length == 0) return '暂未同步详细设定'
		return parts.join(' / ')
	}

	function formatDate(dateStr : string | null) : string {
		if (dateStr == null || dateStr.length == 0) return '--'
		const date = new Date(dateStr)
		if (isNaN(date.getTime())) return '--'
		const year = `${date.getFullYear()}`
		const month = padNumber(date.getMonth() + 1)
		const day = padNumber(date.getDate())
		return `${year}.${month}.${day}`
	}

	onShow(() => {
		loadGarageData()
	})
</script>

<style scoped>
