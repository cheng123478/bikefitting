		background: #FFFFFF;
		border-radius: 24px;
		border-width: 1px;
		border-color: rgba(43, 42, 41, 0.06);
		border-style: solid;
		box-shadow: 0 12px 30px rgba(43, 42, 41, 0.05);
	}

	.garage-page {
		height: 100%;
		background: #F3F2ED;
	}

	.nav-bar {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		background: rgba(243, 242, 237, 0.98);
		box-sizing: border-box;
		border-bottom: 1rpx solid rgba(43, 42, 41, 0.05);
		z-index: 100;
	}

	.back-btn {
