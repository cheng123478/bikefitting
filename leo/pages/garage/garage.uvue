	}

	.bike-title-row {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 10rpx;
	}

	.bike-name {
		flex: 1;
		font-size: 36rpx;
		line-height: 1.3;
		font-weight: 700;
		color: #2B2A29;
		margin-right: 16rpx;
	}

	.report-badge {
		padding: 8rpx 14rpx;
		border-radius: 999rpx;
		background: #F5F3EE;
		color: #6F6A61;
		font-size: 20rpx;
		font-weight: 700;
	}

	.bike-remark {
		font-size: 24rpx;
		color: #6E6A61;
		line-height: 1.6;
		margin-bottom: 12rpx;
	}

	.bike-meta-row {
		flex-direction: row;
		align-items: center;
		flex-wrap: wrap;
		margin-bottom: 24rpx;
	}

	.bike-meta {
		font-size: 24rpx;
		color: #787673;
	}

	.bike-meta-dot {
		margin: 0 10rpx;
		font-size: 22rpx;
		color: #BBB3A4;
	}

	.metric-grid {
		flex-direction: row;
