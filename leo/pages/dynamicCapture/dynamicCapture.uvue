	function resolveMetricTarget(metricKey : string) : string {
		if (viewType.value == 'side') {
			if (metricKey == 'knee') return '140°-150°'
			if (metricKey == 'hip') return '45°-55°'
			if (metricKey == 'torso') return '40°-50°'
			if (metricKey == 'reach') return '85°-95°'
			if (metricKey == 'ankle') return '10°-25°'
			if (metricKey == 'kops') return '<10%'
		}
		if (viewType.value == 'front') {
			if (metricKey == 'leftKnee') return '0%-10%'
			if (metricKey == 'rightKnee') return '0%-10%'
			if (metricKey == 'hipTilt') return '0°-3°'
			if (metricKey == 'shoulderTilt') return '0°-3°'
		}
		if (metricKey == 'pelvisSway') return '0%-8%'
		if (metricKey == 'spineTilt') return '0°-4°'
		if (metricKey == 'leftHipDrop') return '0%-6%'
		if (metricKey == 'rightHipDrop') return '0%-6%'
		return '--'
	}

	function getMetricCardTitle(index : number) : string {
		if (viewType.value == 'side') {
			if (index == 0) return '膝角 (伸展度)'
			if (index == 1) return '髋角 (核心)'
			if (index == 2) return '躯干前角 (Torso Pitch)'
			if (index == 3) return '伸展角度 (Reach)'
			if (index == 4) return '下死点跖屈代理 (Ankling / BDC)'
			return '膝前后偏移代理 (KOPS Proxy)'
		}
		if (viewType.value == 'front') {
			if (index == 0) return '左膝轨迹'
			if (index == 1) return '右膝轨迹'
			if (index == 2) return '髋侧倾'
			return '肩侧倾'
		}
		if (index == 0) return '骨盆横摆'
		if (index == 1) return '脊柱侧偏'
		if (index == 2) return '左髋下沉'
		return '右髋下沉'
	}

	function getMetricCardTarget(index : number) : string {
		if (viewType.value == 'side') {
			if (index == 0) return resolveMetricTarget('knee')
			if (index == 1) return resolveMetricTarget('hip')
			if (index == 2) return resolveMetricTarget('torso')
			if (index == 3) return resolveMetricTarget('reach')
			if (index == 4) return resolveMetricTarget('ankle')
			return resolveMetricTarget('kops')
		}
		if (viewType.value == 'front') {
			if (index == 0) return resolveMetricTarget('leftKnee')
			if (index == 1) return resolveMetricTarget('rightKnee')
			if (index == 2) return resolveMetricTarget('hipTilt')
			return resolveMetricTarget('shoulderTilt')
		}
		if (index == 0) return resolveMetricTarget('pelvisSway')
		if (index == 1) return resolveMetricTarget('spineTilt')
		if (index == 2) return resolveMetricTarget('leftHipDrop')
		return resolveMetricTarget('rightHipDrop')
	}

	function getMetricCardCurrentValue(index : number) : string {
		if (viewType.value == 'side') {
			const metrics = getActiveMetricsObject()
			if (metrics == null) {
				return '--'
			}
			if (index == 0) return getMetricText(metrics, 'kneeAngle', '°')
			if (index == 1) return getMetricText(metrics, 'hipAngle', '°')
			if (index == 2) return getMetricText(metrics, 'torsoAngle', '°')
			if (index == 3) return getMetricText(metrics, 'reachAngle', '°')
			if (index == 4) return getMetricText(metrics, 'ankleAtBdc', '°')
			return getMetricText(metrics, 'kopsOffset', '%')
		}
		if (index == 0) {
			return realtimeMetricOneValue.value.length > 0 ? realtimeMetricOneValue.value : '--'
		}
		if (index == 1) {
			return realtimeMetricTwoValue.value.length > 0 ? realtimeMetricTwoValue.value : '--'
		}
		if (index == 2) {
			return realtimeMetricThreeValue.value.length > 0 ? realtimeMetricThreeValue.value : '--'
		}
		return realtimeMetricFourValue.value.length > 0 ? realtimeMetricFourValue.value : '--'
	}

	function getMetricCardExtremeValue(index : number) : string {
		if (!analysisSaved.value) {
			return '--'
		}
		if (viewType.value == 'side') {
			if (index == 0) return analysisMetricOneValue.value.length > 0 ? analysisMetricOneValue.value : '--'
			if (index == 1) return analysisMetricTwoValue.value.length > 0 ? analysisMetricTwoValue.value : '--'
			if (index == 2) return analysisMetricThreeValue.value.length > 0 ? analysisMetricThreeValue.value : '--'
			if (index == 3) return getFrameMetricExtremeText('reachAngle', '°')
			if (index == 4) return getSummaryMetricValue('ankleAtBdc', '°')
			return getSummaryMetricValue('kopsOffset', '%')
		}
		if (viewType.value == 'front') {
			if (index == 0) return getSummaryMetricValue('maxWobble_L', '%')
			if (index == 1) return getSummaryMetricValue('maxWobble_R', '%')
			if (index == 2) return getSummaryMetricValue('maxHipTilt', '°')
			return getSummaryMetricValue('maxShoulderTilt', '°')
		}
		if (index == 0) return getSummaryMetricValue('maxPelvisSway', '%')
		if (index == 1) return getSummaryMetricValue('maxSpineTilt', '°')
		if (index == 2) return getSummaryMetricValue('maxHipDrop_L', '%')
		return getSummaryMetricValue('maxHipDrop_R', '%')
	}

	const stageVideoShellStyle = computed(() : any => {
		return {
			height: `${resolveStageVideoHeightPx()}px`
		}
	})

	const playbackProgressPercent = computed(() : number => {
		const durationMs = resolvePlaybackDurationMs()
		if (durationMs <= 0) {
			return 0
		}
		let percent = playbackMs.value * 100.0 / durationMs
		if (percent < 0) {
			percent = 0
		}
		if (percent > 100) {
			percent = 100
		}
		return percent
	})

	const playbackProgressFillStyle = computed(() : any => {
		return {
			width: `${playbackProgressPercent.value}%`
		}
	})

	const playbackProgressThumbStyle = computed(() : any => {
		return {
			left: `${playbackProgressPercent.value}%`
		}
	})

	const visiblePointNames = computed(() : string[] => {
		if (viewType.value == 'side') {
			return sidePointNames
		}
		return torsoPointNames
	})

	const visibleSegmentKeys = computed(() : string[] => {
		if (viewType.value == 'side') {
			return sideSegmentKeys
		}
		return torsoSegmentKeys
	})

	function resetActiveFrameCache() {
		activeFrameCacheMs = -1
		activeFrameCache = null
		activeMetricsCache = null
		activePointsCache = null
	}

	function clearAutoPlaybackTimer() {
		if (autoPlaybackTimer > 0) {
			clearTimeout(autoPlaybackTimer)
			autoPlaybackTimer = 0
		}
	}

	function clearCaptureCache() {
		latestCaptureObjectCache = null
		latestSummaryCache = null
		latestSampleMetaCache = null
		latestFrameDataCache = createAnyArray()
		resetActiveFrameCache()
	}

	function updateCaptureCache(result : any | null) {
		if (result == null) {
			clearCaptureCache()
			return
		}
		const resultObject = toJsonObject(result)
		latestCaptureObjectCache = resultObject
		if (resultObject == null) {
			clearCaptureCache()
			return
		}
		latestSummaryCache = toJsonObject(getJsonValue(resultObject, 'summary'))
		latestSampleMetaCache = toJsonObject(getJsonValue(resultObject, 'sampleMeta'))
		latestFrameDataCache = toJsonArray(getJsonValue(resultObject, 'frameData'))
		resetActiveFrameCache()
	}

	function stopSlowPlayback() {
		clearAutoPlaybackTimer()
		videoPlaying.value = false
		try {
			const videoContext = uni.createVideoContext('dynamic-capture-preview-video')
			if (videoContext != null) {
				videoContext.pause()
			}
		} catch (e) {
			console.warn('[DynamicCapture] stop playback failed', e)
		}
	}

	function startPlaybackFromBeginning() {
		if (selectedVideoPath.value.length == 0) {
			return
		}
		stopSlowPlayback()
		playbackMs.value = 0
		resetActiveFrameCache()
		clearAutoPlaybackTimer()
		autoPlaybackTimer = setTimeout(() => {
			try {
				const videoContext = uni.createVideoContext('dynamic-capture-preview-video')
				if (videoContext == null) {
					return
				}
				videoContext.seek(0)
				videoContext.playbackRate(videoPlaybackRate)
				videoContext.play()
				videoPlaying.value = true
			} catch (e) {
				videoPlaying.value = false
				console.warn('[DynamicCapture] start playback failed', e)
			} finally {
				autoPlaybackTimer = 0
			}
		}, 120)
	}

	function resetAnalysisState() {
		stopSlowPlayback()
		analysisSaved.value = false
		latestCaptureResult.value = null
		clearCaptureCache()
		playbackMs.value = 0
		playbackDurationMs.value = 0
		videoPlaying.value = false
	}

	function handleVideoTimeUpdate(event : any) {
		const eventObject = toJsonObject(event)
		const detail = toJsonObject(getJsonValue(eventObject, 'detail'))
		let currentTimeSec = getJsonNumber(detail, 'currentTime', -1)
		if (currentTimeSec < 0) {
			currentTimeSec = getJsonNumber(eventObject, 'currentTime', 0)
		}
		playbackMs.value = Math.round(currentTimeSec * 1000)

		let durationSec = getJsonNumber(detail, 'duration', -1)
		if (durationSec < 0) {
			durationSec = getJsonNumber(eventObject, 'duration', -1)
		}
		if (durationSec > 0) {
			playbackDurationMs.value = Math.round(durationSec * 1000)
		}
		resetActiveFrameCache()
	}

	function handleVideoEnded() {
		stopSlowPlayback()
		playbackMs.value = resolvePlaybackDurationMs()
		videoPlaying.value = false
	}

	function releasePageMemory() {
		stopSlowPlayback()
		clearAutoPlaybackTimer()
		analyzing.value = false
		analysisSaved.value = false
		playbackMs.value = 0
		playbackDurationMs.value = 0
		selectedVideoPath.value = ''
		selectedVideoName.value = ''
		selectedVideoDuration.value = 0
		selectedVideoSize.value = 0
		selectedVideoWidth.value = 0
		selectedVideoHeight.value = 0
		latestCaptureResult.value = null
		clearCaptureCache()
	}

	function toggleVideoPlayback() {
		if (selectedVideoPath.value.length == 0) {
			return
		}
		if (videoPlaying.value) {
			stopSlowPlayback()
			return
		}
		try {
			const videoContext = uni.createVideoContext('dynamic-capture-preview-video')
			if (videoContext == null) {
				return
			}
			videoContext.playbackRate(videoPlaybackRate)
			videoContext.play()
			videoPlaying.value = true
		} catch (e) {
			stopSlowPlayback()
			console.warn('[DynamicCapture] toggle playback failed', e)
		}
	}

	function attachVideoSourceMeta(result : any) : any {
		const resultObject = toJsonObject(result)
		const currentSampleMeta = toJsonObject(getJsonValue(resultObject, 'sampleMeta'))
		const sampleMeta = currentSampleMeta != null ? currentSampleMeta : {} as UTSJSONObject
		const sourceVideo = {} as UTSJSONObject
		sourceVideo['path'] = selectedVideoPath.value
		sourceVideo['name'] = selectedVideoName.value
		sourceVideo['durationSec'] = selectedVideoDuration.value
		sourceVideo['width'] = selectedVideoWidth.value
		sourceVideo['height'] = selectedVideoHeight.value
		sourceVideo['size'] = selectedVideoSize.value
		sampleMeta['sourceVideo'] = sourceVideo
		if (resultObject != null) {
			resultObject['sampleMeta'] = sampleMeta
			return resultObject
		}
		return result
	}

	function extractFileName(path : string) : string {
		if (path.length == 0) {
			return ''
		}
		let normalized = ''
		for (let i = 0; i < path.length; i++) {
			const current = path.substring(i, i + 1)
			normalized += current == '\\' ? '/' : current
		}
		const index = normalized.lastIndexOf('/')
		return index >= 0 ? normalized.substring(index + 1) : normalized
	}

	function toJsonObject(value : any | null) : UTSJSONObject | null {
		if (value == null) {
			return null
		}
		const jsonText = JSON.stringify(value)
		const parsed = JSON.parse(jsonText)
		return parsed != null ? parsed as UTSJSONObject : null
	}

	function getJsonValue(source : UTSJSONObject | null, key : string) : any | null {
		const current = source
		if (current == null) {
			return null
		}
		const value = current[key]
		return value != null ? value : null
	}

	function getJsonText(source : UTSJSONObject | null, key : string, fallback : string) : string {
		const value = getJsonValue(source, key)
		return value != null ? `${value}` : fallback
	}

	function toSafeNumber(value : any | null, fallback : number) : number {
		if (value == null) {
			return fallback
		}
		const parsed = parseFloat(`${value}`)
		return isNaN(parsed) ? fallback : parsed
	}

	function getJsonNumber(source : UTSJSONObject | null, key : string, fallback : number) : number {
		const value = getJsonValue(source, key)
		return value != null ? toSafeNumber(value, fallback) : fallback
	}

	function goBack() {
		const pages = getCurrentPages()
		if (pages.length > 1) {
			uni.navigateBack({
				delta: 1,
				fail: () => {
					uni.navigateTo({ url: '/pages/dynamicSession/dynamicSession' })
				}
			})
		} else {
			uni.navigateTo({ url: '/pages/dynamicSession/dynamicSession' })
		}
	}

	function finishAndReturn() {
		goBack()
	}

	function chooseVideo() {
		if (analyzing.value) {
			return
		}
		resetAnalysisState()
		uni.chooseVideo({
			sourceType: ['camera', 'album'],
			camera: 'back',
			compressed: false,
			maxDuration: 30,
			success: (res : any) => {
				const result = toJsonObject(res)
				selectedVideoPath.value = getJsonText(result, 'tempFilePath', '')
				selectedVideoName.value = extractFileName(selectedVideoPath.value)
				selectedVideoDuration.value = Math.round(getJsonNumber(result, 'duration', 0))
				selectedVideoSize.value = Math.round(getJsonNumber(result, 'size', 0))
				selectedVideoWidth.value = Math.round(getJsonNumber(result, 'width', 0))
				selectedVideoHeight.value = Math.round(getJsonNumber(result, 'height', 0))
				playbackMs.value = 0
				playbackDurationMs.value = selectedVideoDuration.value > 0 ? selectedVideoDuration.value * 1000 : 0
			},
			fail: (err : any) => {
				const errorObject = toJsonObject(err)
				const message = getJsonText(errorObject, 'errMsg', '')
				if (message.indexOf('cancel') >= 0) {
					return
				}
				console.error('[DynamicCapture] choose video failed', err)
				uni.showToast({
					title: '视频选择失败',
					icon: 'none'
				})
			}
		})
	}

	async function analyzeSelectedVideo() {
		if (analyzing.value) {
			return
		}
		if (selectedVideoPath.value.length == 0) {
			uni.showToast({
				title: '请先录制或选择视频',
				icon: 'none'
			})
			return
		}

		analyzing.value = true
		uni.showLoading({
			title: '分析中...',
			mask: true
		})
		try {
			const result = await finalizeDynamicCapture(
				viewType.value,
				selectedVideoPath.value,
				selectedVideoDuration.value
			)
			const normalizedResult = attachVideoSourceMeta(result)
			initDynamicSession(bikeId.value)
			saveDynamicCapture(viewType.value, normalizedResult)
			latestCaptureResult.value = normalizedResult
			updateCaptureCache(normalizedResult)
			analysisSaved.value = true
			playbackMs.value = 0
			playbackDurationMs.value = selectedVideoDuration.value > 0 ? selectedVideoDuration.value * 1000 : resolveFrameSeriesDurationMs()
			uni.showToast({
				title: '分析完成',
				icon: 'success'
			})
			startPlaybackFromBeginning()
		} catch (e) {
			console.error('[DynamicCapture] analyze failed', e)
			const errorText = `${e}`
			uni.showModal({
				title: '姿态分析失败',
				content: errorText.length > 0 ? errorText : 'Unknown native pose error',
				showCancel: false
			})
			return
		} finally {
			analyzing.value = false
			uni.hideLoading()
		}
	}

	async function saveMockCapture() {
		if (analyzing.value) {
			return
		}
		analyzing.value = true
		try {
			const result = await finalizeDynamicCapture(viewType.value, null, 8)
			initDynamicSession(bikeId.value)
			saveDynamicCapture(viewType.value, result)
			latestCaptureResult.value = result
			updateCaptureCache(result)
			analysisSaved.value = true
			playbackMs.value = 0
			playbackDurationMs.value = resolveFrameSeriesDurationMs()
			uni.showToast({
				title: '分析完成',
				icon: 'success'
			})
			startPlaybackFromBeginning()
		} catch (e) {
			console.error('[DynamicCapture] mock save failed', e)
			uni.showToast({
				title: '调试数据生成失败',
				icon: 'none'
			})
		} finally {
			analyzing.value = false
		}
	}

	onLoad((query : any | null) => {
		const params = toJsonObject(query)
		const nextViewType = getJsonText(params, 'viewType', '')
		if (nextViewType.length > 0) {
			viewType.value = nextViewType
		}
		const nextBikeId = getJsonNumber(params, 'bikeId', 0)
		if (nextBikeId > 0) {
			bikeId.value = Math.round(nextBikeId)
			if (bikeId.value > 0) {
				initDynamicSession(bikeId.value)
			}
		}
	})

	onUnload(() => {
		releasePageMemory()
	})

</script>

