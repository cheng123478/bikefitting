<template>
	<view class="capture-page">
		<view class="stage-nav" :style="navBarStyle">
			<view class="stage-back" :style="navBackStyle" @click="goBack">
				<text class="stage-back-icon">&lt;</text>
			</view>
			<text class="stage-title" :style="navTitleStyle">VIDEO ANALYZER</text>
		</view>

		<scroll-view class="stage-scroll" scroll-y="true" :show-scrollbar="false" :style="contentScrollStyle">
			<view class="stage-shell">
				<view class="stage-board">
					<view class="stage-video-shell" :style="stageVideoShellStyle">
						<video
							id="dynamic-capture-preview-video"
							class="stage-video"
							:src="selectedVideoPath"
							:controls="false"
							:show-center-play-btn="false"
							:show-play-btn="false"
							:show-fullscreen-btn="true"
							@timeupdate="handleVideoTimeUpdate"
							@ended="handleVideoEnded"
							object-fit="contain"
						/>

						<view v-if="selectedVideoPath.length == 0" class="stage-empty">
							<text class="stage-empty-desc">{{ captureGuideText }}</text>
						</view>

						<view v-if="playbackHudVisible" class="pose-overlay">
							<view
								v-for="(segmentKey, segmentIndex) in visibleSegmentKeys"
								:key="'segment-' + segmentIndex"
								class="pose-segment"
								:style="getSegmentStyle(segmentKey)"
							></view>
							<view
								v-for="(pointName, pointIndex) in visiblePointNames"
								:key="'point-' + pointIndex"
								class="pose-point"
								:style="getPointStyle(pointName)"
							></view>
						</view>

						<view v-if="analyzing" class="stage-analysis-card">
							<text class="stage-analysis-title">Aries 引擎解析视频中（0.5倍速）...</text>
							<view class="stage-analysis-bar">
								<view class="stage-analysis-fill"></view>
							</view>
						</view>
					</view>

					<view v-if="selectedVideoPath.length > 0" class="transport-card">
						<view class="transport-play" @click="toggleVideoPlayback">
							<text class="transport-play-icon">{{ videoPlaying ? '||' : '▶' }}</text>
						</view>
						<view class="transport-progress">
							<view class="transport-track">
								<view class="transport-track-fill" :style="playbackProgressFillStyle"></view>
								<view class="transport-track-thumb" :style="playbackProgressThumbStyle"></view>
							</view>
						</view>
						<text class="transport-time">{{ playbackPositionText }}</text>
					</view>

					<view class="action-row">
						<view class="stage-action stage-action-primary" :class="analyzing ? 'stage-action-disabled' : ''" @click="chooseVideo">
							<text class="stage-action-primary-text">{{ selectedVideoPath.length > 0 ? '重新选择视频' : '录制 / 选择视频' }}</text>
						</view>
						<view
							v-if="!analysisSaved"
							class="stage-action stage-action-ghost"
							:class="selectedVideoPath.length == 0 || analyzing ? 'stage-action-disabled' : ''"
							@click="analyzeSelectedVideo"
						>
							<text class="stage-action-ghost-text">{{ analyzing ? '分析中...' : '开始本机分析' }}</text>
						</view>
						<view v-if="analysisSaved" class="stage-action stage-action-ghost" @click="finishAndReturn">
							<text class="stage-action-ghost-text">返回会话</text>
						</view>
						<view v-if="!nativeReady" class="stage-action stage-action-ghost" @click="saveMockCapture">
							<text class="stage-action-ghost-text">使用调试数据</text>
						</view>
					</view>

				</view>

				<view v-if="analysisSaved" class="metric-section">
					<view class="metric-section-head">
						<view class="metric-section-head-main">
							<text class="metric-section-kicker">POSE METRICS</text>
							<text class="metric-section-title">同步指标面板</text>
						</view>
						<text class="metric-section-tip">{{ analysisSaved ? '指标条已放到视频下方，更适合手机竖屏。' : '先完成视频分析，再同步显示角度。' }}</text>
					</view>

					<view class="metric-grid">
						<view class="metric-card">
							<view class="metric-card-head">
								<text class="metric-card-label">{{ getMetricCardTitle(0) }}</text>
								<text class="metric-card-target">目标 {{ getMetricCardTarget(0) }}</text>
							</view>
							<view class="metric-card-row">
								<text class="metric-row-label">实时</text>
								<text class="metric-row-value">{{ getMetricCardCurrentValue(0) }}</text>
							</view>
							<view class="metric-card-row">
								<text class="metric-row-label">极限</text>
								<text class="metric-row-value">{{ getMetricCardExtremeValue(0) }}</text>
							</view>
						</view>
						<view class="metric-card">
							<view class="metric-card-head">
								<text class="metric-card-label">{{ getMetricCardTitle(1) }}</text>
								<text class="metric-card-target">目标 {{ getMetricCardTarget(1) }}</text>
							</view>
							<view class="metric-card-row">
								<text class="metric-row-label">实时</text>
								<text class="metric-row-value">{{ getMetricCardCurrentValue(1) }}</text>
							</view>
							<view class="metric-card-row">
								<text class="metric-row-label">极限</text>
								<text class="metric-row-value">{{ getMetricCardExtremeValue(1) }}</text>
							</view>
						</view>
						<view class="metric-card">
							<view class="metric-card-head">
								<text class="metric-card-label">{{ getMetricCardTitle(2) }}</text>
								<text class="metric-card-target">目标 {{ getMetricCardTarget(2) }}</text>
							</view>
							<view class="metric-card-row">
								<text class="metric-row-label">实时</text>
								<text class="metric-row-value">{{ getMetricCardCurrentValue(2) }}</text>
							</view>
							<view class="metric-card-row">
								<text class="metric-row-label">极限</text>
								<text class="metric-row-value">{{ getMetricCardExtremeValue(2) }}</text>
							</view>
						</view>
						<view class="metric-card">
							<view class="metric-card-head">
								<text class="metric-card-label">{{ getMetricCardTitle(3) }}</text>
								<text class="metric-card-target">目标 {{ getMetricCardTarget(3) }}</text>
							</view>
							<view class="metric-card-row">
								<text class="metric-row-label">实时</text>
								<text class="metric-row-value">{{ getMetricCardCurrentValue(3) }}</text>
							</view>
							<view class="metric-card-row">
								<text class="metric-row-label">极限</text>
								<text class="metric-row-value">{{ getMetricCardExtremeValue(3) }}</text>
							</view>
						</view>
						<view v-if="viewType == 'side'" class="metric-card">
							<view class="metric-card-head">
								<text class="metric-card-label">{{ getMetricCardTitle(4) }}</text>
								<text class="metric-card-target">目标 {{ getMetricCardTarget(4) }}</text>
							</view>
							<view class="metric-card-row">
								<text class="metric-row-label">实时</text>
								<text class="metric-row-value">{{ getMetricCardCurrentValue(4) }}</text>
							</view>
							<view class="metric-card-row">
								<text class="metric-row-label">极限</text>
								<text class="metric-row-value">{{ getMetricCardExtremeValue(4) }}</text>
							</view>
						</view>
						<view v-if="viewType == 'side'" class="metric-card">
							<view class="metric-card-head">
								<text class="metric-card-label">{{ getMetricCardTitle(5) }}</text>
								<text class="metric-card-target">目标 {{ getMetricCardTarget(5) }}</text>
							</view>
							<view class="metric-card-row">
								<text class="metric-row-label">实时</text>
								<text class="metric-row-value">{{ getMetricCardCurrentValue(5) }}</text>
							</view>
							<view class="metric-card-row">
								<text class="metric-row-label">极限</text>
								<text class="metric-row-value">{{ getMetricCardExtremeValue(5) }}</text>
							</view>
						</view>
					</view>

					<text class="metric-footer-note">{{ analysisStatusText }}</text>
					<text class="metric-footer-note metric-footer-note-muted">{{ providerStatus }}</text>
				</view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { computed, ref } from 'vue'
	import { initDynamicSession, saveDynamicCapture } from '@/store/dynamicSession.uts'
	import {
		finalizeDynamicCapture,
		getDynamicViewTitle,
		getNativePoseStatusText,
		isNativePosePluginReady
	} from '@/utils/dynamicNativeBridge.uts'
	import { getAppLayoutMetrics } from '@/utils/layout.uts'

	const layout = getAppLayoutMetrics()
	const navContentCenter = layout.statusBarHeight + layout.navBarContentHeight / 2
	const navBarStyle = {
		height: layout.navBarHeight + 'px',
		paddingTop: layout.statusBarHeight + 'px',
		boxSizing: 'border-box'
	}
	const navBackStyle = {
		top: navContentCenter + 'px'
	}
	const navTitleStyle = {
		top: navContentCenter + 'px'
	}
	const contentScrollStyle = {
		top: layout.navBarHeight + 'px',
		paddingBottom: layout.bottomSafeArea + 28 + 'px'
	}

	const viewType = ref('side')
	const bikeId = ref(0)
	const nativeReady = isNativePosePluginReady()
	const providerStatus = getNativePoseStatusText()
	const selectedVideoPath = ref('')
	const selectedVideoName = ref('')
	const selectedVideoDuration = ref(0)
	const selectedVideoSize = ref(0)
	const selectedVideoWidth = ref(0)
	const selectedVideoHeight = ref(0)
	const analyzing = ref(false)
	const analysisSaved = ref(false)
	const latestCaptureResult = ref<any | null>(null)
	const playbackMs = ref(0)
	const playbackDurationMs = ref(0)
	const videoPlaying = ref(false)
	const videoPlaybackRate = 0.5
	const windowInfo = uni.getWindowInfo()
	const stageWidthPx = Math.max(220, windowInfo.windowWidth - layout.pageHorizontalPadding * 2 - 24)
	let latestCaptureObjectCache : UTSJSONObject | null = null
	let latestSummaryCache : UTSJSONObject | null = null
	let latestSampleMetaCache : UTSJSONObject | null = null
	let latestFrameDataCache : any[] = []
	let activeFrameCacheMs = -1
	let activeFrameCache : UTSJSONObject | null = null
	let activeMetricsCache : UTSJSONObject | null = null
	let activePointsCache : UTSJSONObject | null = null
	let autoPlaybackTimer = 0

	const sidePointNames : string[] = ['EAR', 'SHOULDER', 'ELBOW', 'WRIST', 'HIP', 'KNEE', 'ANKLE', 'HEEL', 'TOE']
	const torsoPointNames : string[] = ['L_SHOULDER', 'R_SHOULDER', 'L_HIP', 'R_HIP', 'L_KNEE', 'R_KNEE', 'L_ANKLE', 'R_ANKLE']
	const sideSegmentKeys : string[] = [
		'EAR:SHOULDER',
		'SHOULDER:ELBOW',
		'ELBOW:WRIST',
		'SHOULDER:HIP',
		'HIP:KNEE',
		'KNEE:ANKLE',
		'ANKLE:HEEL',
		'HEEL:TOE'
	]
	const torsoSegmentKeys : string[] = [
		'L_SHOULDER:R_SHOULDER',
		'L_SHOULDER:L_HIP',
		'R_SHOULDER:R_HIP',
		'L_HIP:R_HIP',
		'L_HIP:L_KNEE',
		'R_HIP:R_KNEE',
		'L_KNEE:L_ANKLE',
		'R_KNEE:R_ANKLE'
	]

	const captureGuideText = computed(() : string => {
		if (viewType.value == 'side') {
			return '侧面视角用于计算膝角、髋角、躯干俯角、踝角代理和 KOPS 代理。镜头尽量与车身正侧平齐。'
		}
		if (viewType.value == 'front') {
			return '正面视角用于观察膝轨迹、髋肩倾斜和肘部外张。镜头与车把中心对齐，避免斜拍。'
		}
		return '背面视角用于观察骨盆横摆、脊柱侧倾、肩部高低和左右髋下沉。镜头尽量置于车后正中。'
	})

	const selectedDurationText = computed(() : string => {
		if (selectedVideoDuration.value <= 0) {
			return '--'
		}
		return `${selectedVideoDuration.value}s`
	})

	const selectedResolutionText = computed(() : string => {
		if (selectedVideoWidth.value <= 0 || selectedVideoHeight.value <= 0) {
			return '--'
		}
		return `${selectedVideoWidth.value} x ${selectedVideoHeight.value}`
	})

	const selectedFileSizeText = computed(() : string => {
		if (selectedVideoSize.value <= 0) {
			return '--'
		}
		const size = selectedVideoSize.value
		if (size >= 1024 * 1024) {
			return `${(size / 1024 / 1024).toFixed(1)} MB`
		}
		return `${Math.round(size / 1024)} KB`
	})

	const analysisStatusText = computed(() : string => {
		if (!analysisSaved.value || latestCaptureResult.value == null) {
			return '尚未生成分析结果'
		}
		return '本次视频已完成姿态解析，结果已写入当前会话草稿。后续可以继续补齐其他视角，再统一提交。'
	})

	function getLatestSummaryObject() : UTSJSONObject | null {
		if (!analysisSaved.value || latestCaptureResult.value == null) {
			return null
		}
		return latestSummaryCache
	}

	function createAnyArray() : any[] {
		const items : any[] = []
		return items
	}

	function toJsonArray(value : any | null) : any[] {
		if (value == null) {
			return createAnyArray()
		}
		const jsonText = JSON.stringify(value)
		const parsed = JSON.parse(jsonText)
		return parsed != null ? parsed as any[] : createAnyArray()
	}

	function getLatestCaptureObject() : UTSJSONObject | null {
		if (!analysisSaved.value || latestCaptureResult.value == null) {
			return null
		}
		return latestCaptureObjectCache
	}

	function getLatestSampleMetaObject() : UTSJSONObject | null {
		if (!analysisSaved.value || latestCaptureResult.value == null) {
			return null
		}
		return latestSampleMetaCache
	}

	function getLatestFrameDataArray() : any[] {
		if (!analysisSaved.value || latestCaptureResult.value == null) {
			return createAnyArray()
		}
		return latestFrameDataCache
	}

	function resolveCaptureFps() : number {
		const sampleMeta = getLatestSampleMetaObject()
		const fps = getJsonNumber(sampleMeta, 'fps', 12)
		return fps > 0 ? fps : 12
	}

	function resolveFrameTimestampMs(frame : any, index : number) : number {
		const frameObject = toJsonObject(frame)
		const directTimestamp = getJsonNumber(frameObject, 'ts', -1)
		if (directTimestamp >= 0) {
			return Math.round(directTimestamp)
		}
		const timeSec = getJsonNumber(frameObject, 'timeSec', -1)
		if (timeSec >= 0) {
			return Math.round(timeSec * 1000)
		}
		const frameIndex = getJsonNumber(frameObject, 'frameIndex', -1)
		if (frameIndex >= 0) {
			return Math.round(frameIndex * 1000 / resolveCaptureFps())
		}
		const fallbackIndex = getJsonNumber(frameObject, 'fIdx', index)
		return Math.round(fallbackIndex * 1000 / resolveCaptureFps())
	}

	function resolveFrameSeriesDurationMs() : number {
		const frames = getLatestFrameDataArray()
		if (frames.length == 0) {
			return 0
		}
		return resolveFrameTimestampMs(frames[frames.length - 1], frames.length - 1)
	}

	function resolvePlaybackDurationMs() : number {
		if (playbackDurationMs.value > 0) {
			return playbackDurationMs.value
		}
		if (selectedVideoDuration.value > 0) {
			return selectedVideoDuration.value * 1000
		}
		return resolveFrameSeriesDurationMs()
	}

	function resolveActiveFrameIndex() : number {
		const frames = getLatestFrameDataArray()
		if (frames.length == 0) {
			return -1
		}
		const targetMs = playbackMs.value
		let bestIndex = 0
		let bestDistance = Math.abs(resolveFrameTimestampMs(frames[0], 0) - targetMs)
		for (let i = 1; i < frames.length; i++) {
			const distance = Math.abs(resolveFrameTimestampMs(frames[i], i) - targetMs)
			if (distance < bestDistance) {
				bestDistance = distance
				bestIndex = i
			}
		}
		return bestIndex
	}

	function syncActiveFrameCache() {
		if (!analysisSaved.value) {
			activeFrameCacheMs = -1
			activeFrameCache = null
			activeMetricsCache = null
			activePointsCache = null
			return
		}
		const targetMs = playbackMs.value
		if (activeFrameCacheMs == targetMs) {
			return
		}
		activeFrameCacheMs = targetMs
		activeFrameCache = null
		activeMetricsCache = null
		activePointsCache = null
		const frames = getLatestFrameDataArray()
		const activeIndex = resolveActiveFrameIndex()
		if (activeIndex < 0 || activeIndex >= frames.length) {
			return
		}
		const frameValue = frames[activeIndex]
		if (frameValue == null) {
			return
		}
		const frameText = JSON.stringify(frameValue)
		const frameParsed = JSON.parse(frameText)
		if (frameParsed == null) {
			return
		}
		const frameObject = frameParsed as UTSJSONObject
		activeFrameCache = frameObject

		const metricsValue = frameObject['metrics']
		if (metricsValue != null) {
			const metricsText = JSON.stringify(metricsValue)
			const metricsParsed = JSON.parse(metricsText)
			activeMetricsCache = metricsParsed != null ? metricsParsed as UTSJSONObject : null
		}

		const pointsValue = frameObject['pts']
		if (pointsValue != null) {
			const pointsText = JSON.stringify(pointsValue)
			const pointsParsed = JSON.parse(pointsText)
			activePointsCache = pointsParsed != null ? pointsParsed as UTSJSONObject : null
		}
	}

	function getActiveFrameObject() : UTSJSONObject | null {
		syncActiveFrameCache()
		return activeFrameCache
	}

	function getActiveMetricsObject() : UTSJSONObject | null {
		syncActiveFrameCache()
		return activeMetricsCache
	}

	function formatDurationMs(valueMs : number) : string {
		if (valueMs <= 0) {
			return '00:00'
		}
		const totalSeconds = Math.floor(valueMs / 1000)
		const minutes = Math.floor(totalSeconds / 60)
		const seconds = totalSeconds % 60
		const minutesText = minutes < 10 ? `0${minutes}` : `${minutes}`
		const secondsText = seconds < 10 ? `0${seconds}` : `${seconds}`
		return `${minutesText}:${secondsText}`
	}

	function getMetricText(source : UTSJSONObject | null, key : string, unit : string) : string {
		if (source == null) {
			return '--'
		}
		const value = getJsonValue(source, key)
		if (value == null) {
			return '--'
		}
		return `${value}${unit}`
	}

	function formatMetricNumber(value : number, unit : string) : string {
		const rounded = Math.round(value * 10.0) / 10.0
		return `${rounded}${unit}`
	}

	function getFrameMetricExtremeText(metricKey : string, unit : string, useAbsolute : boolean = false) : string {
		const frames = getLatestFrameDataArray()
		if (frames.length == 0) {
			return '--'
		}
		let hasValue = false
		let extreme = 0.0
		for (let i = 0; i < frames.length; i++) {
			const frameObject = toJsonObject(frames[i])
			const metrics = toJsonObject(getJsonValue(frameObject, 'metrics'))
			const currentValue = getJsonValue(metrics, metricKey)
			if (currentValue == null) {
				continue
			}
			let metricValue = toSafeNumber(currentValue, 0)
			if (useAbsolute) {
				metricValue = Math.abs(metricValue)
			}
			if (!hasValue || metricValue > extreme) {
				extreme = metricValue
				hasValue = true
			}
		}
		return hasValue ? formatMetricNumber(extreme, unit) : '--'
	}

	function getSummaryMetricValue(key : string, unit : string) : string {
		const summary = getLatestSummaryObject()
		if (summary == null) {
			return '--'
		}
		const value = getJsonValue(summary, key)
		if (value == null) {
			return '--'
		}
		return `${value}${unit}`
	}

	function resolveVideoAspectRatio() : number {
		if (selectedVideoWidth.value > 0 && selectedVideoHeight.value > 0) {
			return selectedVideoWidth.value / selectedVideoHeight.value
		}
		return 16.0 / 9.0
	}

	function resolveStageVideoHeightPx() : number {
		const aspectRatio = resolveVideoAspectRatio()
		const isPortraitVideo = aspectRatio < 0.82
		let height = stageWidthPx / aspectRatio
		let minHeight = 220
		let maxHeight = 360
		if (isPortraitVideo) {
			minHeight = 360
			maxHeight = Math.min(560, Math.round(windowInfo.windowHeight * 0.6))
		} else if (aspectRatio < 1.15) {
			minHeight = 280
			maxHeight = 420
		}
		if (height < minHeight) {
			height = minHeight
		}
		if (height > maxHeight) {
			height = maxHeight
		}
		return Math.round(height)
	}

	function resolveRenderedVideoRect() : UTSJSONObject {
		const shellWidth = stageWidthPx
		const shellHeight = resolveStageVideoHeightPx()
		const videoAspect = resolveVideoAspectRatio()
		const shellAspect = shellWidth / shellHeight

		let rectWidth = shellWidth
		let rectHeight = shellHeight
		let offsetLeft = 0.0
		let offsetTop = 0.0

		if (videoAspect > shellAspect) {
			rectWidth = shellWidth
			rectHeight = shellWidth / videoAspect
			offsetTop = (shellHeight - rectHeight) / 2.0
		} else {
			rectHeight = shellHeight
			rectWidth = shellHeight * videoAspect
			offsetLeft = (shellWidth - rectWidth) / 2.0
		}

		return {
			left: offsetLeft,
			top: offsetTop,
			width: rectWidth,
			height: rectHeight
		} as UTSJSONObject
	}

	function getActivePointsObject() : UTSJSONObject | null {
		syncActiveFrameCache()
		return activePointsCache
	}

	function getNamedPoint(pointName : string) : UTSJSONObject | null {
		const points = getActivePointsObject()
		if (points == null) {
			return null
		}
		const pointValue = getJsonValue(points, pointName)
		return toJsonObject(pointValue)
	}

	function hasNamedPoint(pointName : string) : boolean {
		const point = getNamedPoint(pointName)
		if (point == null) {
			return false
		}
		const xValue = getJsonValue(point, 'x')
		const yValue = getJsonValue(point, 'y')
		return xValue != null && yValue != null
	}

	function resolvePointPosition(pointName : string) : UTSJSONObject | null {
		const point = getNamedPoint(pointName)
		if (point == null) {
			return null
		}
		const rect = resolveRenderedVideoRect()
		const left = getJsonNumber(rect, 'left', 0)
		const top = getJsonNumber(rect, 'top', 0)
		const width = getJsonNumber(rect, 'width', stageWidthPx)
		const height = getJsonNumber(rect, 'height', resolveStageVideoHeightPx())
		const x = getJsonNumber(point, 'x', -1)
		const y = getJsonNumber(point, 'y', -1)
		if (x < 0 || y < 0) {
			return null
		}
		return {
			x: left + x * width,
			y: top + y * height
		} as UTSJSONObject
	}

	function getPointStyle(pointName : string) : any {
		const pointPosition = resolvePointPosition(pointName)
		if (pointPosition == null) {
			return {
				left: '-1000px',
				top: '-1000px'
			}
		}
		return {
			left: `${getJsonNumber(pointPosition, 'x', 0)}px`,
			top: `${getJsonNumber(pointPosition, 'y', 0)}px`
		}
	}

	function parseSegmentStart(segmentKey : string) : string {
		const separatorIndex = segmentKey.indexOf(':')
		return separatorIndex >= 0 ? segmentKey.substring(0, separatorIndex) : segmentKey
	}

	function parseSegmentEnd(segmentKey : string) : string {
		const separatorIndex = segmentKey.indexOf(':')
		return separatorIndex >= 0 ? segmentKey.substring(separatorIndex + 1) : segmentKey
	}

	function hasSegment(segmentKey : string) : boolean {
		return hasNamedPoint(parseSegmentStart(segmentKey)) && hasNamedPoint(parseSegmentEnd(segmentKey))
	}

	function getSegmentStyle(segmentKey : string) : any {
		const startPosition = resolvePointPosition(parseSegmentStart(segmentKey))
		const endPosition = resolvePointPosition(parseSegmentEnd(segmentKey))
		if (startPosition == null || endPosition == null) {
			return {
				left: '-1000px',
				top: '-1000px',
				width: '0px'
			}
		}
		const startX = getJsonNumber(startPosition, 'x', 0)
		const startY = getJsonNumber(startPosition, 'y', 0)
		const endX = getJsonNumber(endPosition, 'x', 0)
		const endY = getJsonNumber(endPosition, 'y', 0)
		const dx = endX - startX
		const dy = endY - startY
		const length = Math.sqrt(dx * dx + dy * dy)
		const midX = (startX + endX) / 2.0
		const midY = (startY + endY) / 2.0
		const angle = Math.atan2(dy, dx) * 180.0 / Math.PI

		return {
			left: `${midX - length / 2.0}px`,
			top: `${midY - 2}px`,
			width: `${length}px`,
			transform: `rotate(${angle}deg)`
		}
	}

