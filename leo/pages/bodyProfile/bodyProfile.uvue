<template>
	<view class="body-profile-page">
		<view class="nav-bar" :style="{ height: navBarHeight + 'px', paddingTop: statusBarHeight + 'px', boxSizing: 'border-box' }">
			<view class="back-btn" :style="navBackButtonStyle" @click="goBack">
				<text class="back-icon">‹</text>
			</view>
			<text class="nav-title" :style="navTitleStyle">身体图谱</text>
			<view class="nav-right" :style="navRightStyle"></view>
		</view>

		<scroll-view class="content-scroll" scroll-y="true" :show-scrollbar="false" :style="contentScrollStyle">
			<view class="page-shell">
				<view v-if="loading" class="loading-container app-soft-card">
					<text class="loading-text">正在加载身体数据...</text>
				</view>

				<view v-else-if="!hasData" class="empty-card app-soft-card">
					<view class="empty-icon-wrap">
						<text class="empty-icon">📊</text>
					</view>
					<text class="empty-title">暂无身体档案</text>
					<text class="empty-desc">请先完成身体测量，建立你的专属骑行画像，后续静态与动态诊断都会以此为基线。</text>
					<view class="start-btn" @click="startMeasure">
						<text class="btn-text">开始测量</text>
					</view>
				</view>

				<view v-else class="profile-content">
					<view class="hero-card">
						<view class="hero-copy">
							<text class="hero-kicker">BODY BLUEPRINT</text>
							<text class="hero-title">你的骑行身体画像</text>
							<text class="hero-desc">用基础体型、柔韧性和核心稳定性数据，为后续骑行调适提供更可靠的参考。</text>
						</view>
						<view class="hero-score-cluster">
							<view class="score-pill">
								<text class="score-pill-label">柔韧</text>
								<text class="score-pill-value">{{ displayValue(formData.flexibilityScore) }}</text>
							</view>
							<view class="score-pill">
								<text class="score-pill-label">稳定</text>
								<text class="score-pill-value">{{ displayValue(formData.stabilityScore) }}</text>
							</view>
						</view>
					</view>

					<view class="summary-grid">
						<view class="summary-card app-soft-card">
							<text class="summary-label">身高</text>
							<text class="summary-value">{{ displayMetric(formData.height, 'mm') }}</text>
						</view>
						<view class="summary-card app-soft-card">
							<text class="summary-label">跨高</text>
							<text class="summary-value">{{ displayMetric(formData.spanHeight, 'mm') }}</text>
						</view>
						<view class="summary-card app-soft-card">
							<text class="summary-label">BMI</text>
							<text class="summary-value">{{ displayValue(formData.bmi) }}</text>
						</view>
					</view>

					<view class="section-card app-soft-card">
						<view class="section-head">
							<view>
								<text class="section-kicker">BASE DIMENSIONS</text>
								<text class="section-title">基础数据</text>
							</view>
						</view>
						<view class="detail-grid">
							<view class="detail-item">
								<text class="detail-label">身高</text>
								<text class="detail-value">{{ displayMetric(formData.height, 'mm') }}</text>
							</view>
							<view class="detail-item">
								<text class="detail-label">体重</text>
								<text class="detail-value">{{ displayMetric(formData.weightKg, 'kg') }}</text>
							</view>
							<view class="detail-item">
								<text class="detail-label">跨高</text>
								<text class="detail-value">{{ displayMetric(formData.spanHeight, 'mm') }}</text>
							</view>
							<view class="detail-item">
								<text class="detail-label">BMI</text>
								<text class="detail-value">{{ displayValue(formData.bmi) }}</text>
							</view>
						</view>
					</view>

					<view class="section-card app-soft-card">
						<view class="section-head">
							<view>
								<text class="section-kicker">LIMB METRICS</text>
								<text class="section-title">肢体数据</text>
							</view>
						</view>
						<view class="detail-grid">
							<view class="detail-item">
								<text class="detail-label">大腿长</text>
								<text class="detail-value">{{ displayMetric(formData.thighLength, 'mm') }}</text>
							</view>
							<view class="detail-item">
								<text class="detail-label">小腿长</text>
								<text class="detail-value">{{ displayMetric(formData.calfLength, 'mm') }}</text>
							</view>
							<view class="detail-item">
								<text class="detail-label">大臂长</text>
								<text class="detail-value">{{ displayMetric(formData.longArmLength, 'mm') }}</text>
							</view>
							<view class="detail-item">
								<text class="detail-label">小臂长</text>
								<text class="detail-value">{{ displayMetric(formData.shortArmLength, 'mm') }}</text>
							</view>
						</view>
					</view>

					<view class="section-card app-soft-card">
						<view class="section-head">
							<view>
								<text class="section-kicker">FLEXIBILITY</text>
								<text class="section-title">柔韧性评估</text>
							</view>
							<view class="section-guide" @click="openThoracicGuide">
								<text class="section-guide-text">测量说明</text>
							</view>
						</view>
						<view class="detail-list">
							<view class="list-row">
								<text class="list-label">举臂角度</text>
								<text class="list-value">{{ displayMetric(formData.armRaiseAngle, '°') }}</text>
							</view>
							<view class="list-row">
								<text class="list-label">胸椎旋转</text>
								<text class="list-value">{{ displayMetric(formData.thoracicRotationAngle, '°') }}</text>
							</view>
							<view class="list-row">
								<text class="list-label">痛感等级</text>
								<text class="list-value">{{ getPainLabel(formData.thoracicPainLevel) }}</text>
							</view>
							<view class="list-row">
								<text class="list-label">柔韧评分</text>
								<text class="list-value accent-green">{{ displayValue(formData.flexibilityScore) }}</text>
							</view>
						</view>
