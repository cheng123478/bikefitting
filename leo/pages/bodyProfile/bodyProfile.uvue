							<view>
								<text class="section-kicker">CORE STABILITY</text>
								<text class="section-title">核心稳定性</text>
							</view>
						</view>
						<view class="detail-list">
							<view class="list-row">
								<text class="list-label">深蹲评分</text>
								<text class="list-value">{{ displayValue(formData.squatStabilityScore) }}</text>
							</view>
							<view class="list-row">
								<text class="list-label">平板支撑</text>
								<text class="list-value">{{ displayValue(formData.plankScore) }}</text>
							</view>
							<view class="list-row">
								<text class="list-label">稳定性评分</text>
								<text class="list-value accent-green">{{ displayValue(formData.stabilityScore) }}</text>
							</view>
						</view>
					</view>

					<view class="update-card app-soft-card">
						<text class="update-label">最近更新</text>
						<text class="update-value">{{ formatDate(formData.createTime) }}</text>
					</view>

					<view class="edit-btn" @click="goToEdit">
						<text class="btn-text">修改数据</text>
					</view>
				</view>
			</view>
		</scroll-view>

		<view v-if="showGuideModal" class="guide-modal" @click="closeGuide">
			<scroll-view class="guide-content" scroll-y="true" :show-scrollbar="false" :style="guideScrollStyle" @click.stop>
				<view class="guide-header">
					<text class="guide-title">{{ currentGuide.title }}</text>
					<view class="guide-close" @click="closeGuide">
						<text class="close-icon">×</text>
					</view>
				</view>
				<view class="guide-image">
					<image :src="currentGuide.image" mode="aspectFit" class="guide-img" />
				</view>
				<view class="guide-desc">
					<text class="desc-title">测量步骤</text>
					<text class="desc-text">{{ currentGuide.steps }}</text>
				</view>
				<view class="guide-notice">
					<text class="notice-title">注意事项</text>
					<text class="notice-text">{{ currentGuide.notice }}</text>
				</view>
			</scroll-view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref, onMounted } from 'vue'
	import { getLatestUserBody } from '@/api/user.uts'
	import { getAppLayoutMetrics } from '@/utils/layout.uts'

	type GuideItem = {
		title: string
		image: string
		steps: string
		notice: string
	}

	type BodyProfileData = {
		id: number | null
		userId: number | null
		height: number | null
		weightKg: number | null
		spanHeight: number | null
		longArmLength: number | null
		shortArmLength: number | null
		thighLength: number | null
		calfLength: number | null
		armRaiseAngle: number | null
		thoracicRotationAngle: number | null
		thoracicPainLevel: number | null
		squatStabilityScore: number | null
		plankScore: number | null
		bmi: number | null
		flexibilityScore: number | null
		stabilityScore: number | null
		createTime: string | null
	}

	const loading = ref(true)
	const hasData = ref(false)

	const layout = getAppLayoutMetrics()
	const windowInfo = uni.getWindowInfo()
	const statusBarHeight = layout.statusBarHeight
	const navBarHeight = layout.navBarHeight
	const navContentOffset = 6
	const navContentCenter = statusBarHeight + layout.navBarContentHeight / 2 + navContentOffset
	const guideWindowHeight = windowInfo.windowHeight
	const contentScrollStyle = {
		top: navBarHeight + 'px',
		paddingBottom: layout.bottomSafeArea + 24 + 'px'
	}
	const guideScrollStyle = {
		maxHeight: (guideWindowHeight > 0 ? Math.round(guideWindowHeight * 0.8) : 560) + 'px'
	}
	const navBackButtonStyle = {
		top: navContentCenter + 'px'
	}
	const navTitleStyle = {
		top: navContentCenter + 'px'
	}
	const navRightStyle = {
		top: navContentCenter + 'px'
	}

	const showGuideModal = ref(false)
	const currentGuide = ref<GuideItem>({
		title: '',
		image: '',
		steps: '',
		notice: ''
	})

	const thoracicGuide : GuideItem = {
			title: '胸椎旋转 / Thoracic Spine',
			image: '/static/image/fitting/thoracicspine.png',
			steps: '1. 坐姿，背部挺直\n2. 缓慢向一侧转动躯干\n3. 测量旋转角度',
			notice: '评估胸椎灵活性，影响骑行时的转向能力'
	}

	const painLabels = ['无痛', '轻微', '轻度', '中度', '重度', '剧烈']

	const formData = ref<BodyProfileData>({
		id: null,
		userId: null,
		height: null,
		weightKg: null,
		spanHeight: null,
		longArmLength: null,
		shortArmLength: null,
		thighLength: null,
		calfLength: null,
		armRaiseAngle: null,
		thoracicRotationAngle: null,
		thoracicPainLevel: null,
		squatStabilityScore: null,
		plankScore: null,
		bmi: null,
		flexibilityScore: null,
		stabilityScore: null,
		createTime: null
	})

	function toNullableNumber(value : any | null) : number | null {
		if (value == null || value === '') return null
		const parsed = parseFloat(`${value}`)
		return isNaN(parsed) ? null : parsed
	}

	function toNullableText(value : any | null) : string | null {
		return value != null ? `${value}` : null
	}

	function toJsonObject(value : any | null) : UTSJSONObject | null {
		if (value == null) {
			return null
		}
		const jsonText = JSON.stringify(value)
		const parsed = JSON.parse(jsonText)
		return parsed != null ? parsed as UTSJSONObject : null
	}

	function getJsonValue(source : UTSJSONObject | null, key : string) : any | null {
		const current = source
		if (current == null) {
			return null
		}
		const value = current[key]
		return value != null ? value : null
	}

	function normalizeBodyProfileData(raw : any | null) : BodyProfileData {
		const bodyData = toJsonObject(raw)
		return {
			id: toNullableNumber(getJsonValue(bodyData, 'id')),
			userId: toNullableNumber(getJsonValue(bodyData, 'userId')),
			height: toNullableNumber(getJsonValue(bodyData, 'height')),
			weightKg: toNullableNumber(getJsonValue(bodyData, 'weightKg')),
			spanHeight: toNullableNumber(getJsonValue(bodyData, 'spanHeight')),
			longArmLength: toNullableNumber(getJsonValue(bodyData, 'longArmLength')),
			shortArmLength: toNullableNumber(getJsonValue(bodyData, 'shortArmLength')),
			thighLength: toNullableNumber(getJsonValue(bodyData, 'thighLength')),
			calfLength: toNullableNumber(getJsonValue(bodyData, 'calfLength')),
			armRaiseAngle: toNullableNumber(getJsonValue(bodyData, 'armRaiseAngle')),
			thoracicRotationAngle: toNullableNumber(getJsonValue(bodyData, 'thoracicRotationAngle')),
			thoracicPainLevel: toNullableNumber(getJsonValue(bodyData, 'thoracicPainLevel')),
			squatStabilityScore: toNullableNumber(getJsonValue(bodyData, 'squatStabilityScore')),
			plankScore: toNullableNumber(getJsonValue(bodyData, 'plankScore')),
			bmi: toNullableNumber(getJsonValue(bodyData, 'bmi')),
			flexibilityScore: toNullableNumber(getJsonValue(bodyData, 'flexibilityScore')),
			stabilityScore: toNullableNumber(getJsonValue(bodyData, 'stabilityScore')),
			createTime: toNullableText(getJsonValue(bodyData, 'createTime'))
		}
	}

	function openThoracicGuide() {
		currentGuide.value = thoracicGuide
		showGuideModal.value = true
	}

	function closeGuide() {
		showGuideModal.value = false
	}

	function getPainLabel(level : number | null) : string {
		if (level == null) return '--'
		if (level < 0 || level >= painLabels.length) return '--'
		return painLabels[level]
	}

	function padNumber(value : number) : string {
		if (value < 10) return `0${value}`
		return `${value}`
	}

	function displayValue(value : number | null) : string {
		if (value == null) return '--'
		return `${value}`
	}

	function displayMetric(value : number | null, unit : string) : string {
		if (value == null) return '--'
		return `${value}${unit}`
	}

	function formatDate(dateStr : string | null) : string {
		if (dateStr == null || dateStr.length == 0) return '--'
		const date = new Date(dateStr)
		if (isNaN(date.getTime())) return '--'
		const year = `${date.getFullYear()}`
		const month = padNumber(date.getMonth() + 1)
		const day = padNumber(date.getDate())
		return `${year}-${month}-${day}`
	}

	function goBack() {
		const pages = getCurrentPages()
		if (pages.length > 1) {
			uni.navigateBack({
				delta: 1,
				fail: () => {
					uni.switchTab({ url: '/pages/index/index' })
				}
			})
		} else {
			uni.switchTab({ url: '/pages/index/index' })
		}
	}

	function startMeasure() {
		uni.showToast({ title: '测量功能开发中', icon: 'none' })
	}

	function goToEdit() {
		uni.navigateTo({
			url: '/pages/editBody/editBody'
		})
	}

	async function loadData() {
		loading.value = true
		try {
			const data = await getLatestUserBody()
			const nextData = normalizeBodyProfileData(data)
			if (nextData.id != null) {
				hasData.value = true
				formData.value = nextData
			} else {
				hasData.value = false
			}
		} catch (e) {
			console.error('加载身体数据失败', e)
			hasData.value = false
		} finally {
			loading.value = false
		}
	}

	onMounted(() => {
		loadData()
	})
</script>

