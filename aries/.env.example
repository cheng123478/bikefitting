# MySQL 数据库配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=aries_db
MYSQL_USERNAME=root
MYSQL_PASSWORD=your_mysql_password

# Redis 缓存配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=your_redis_password

# 腾讯云 COS 对象存储配置
TX_CLOUD_COS_UID=your_cos_uid
TX_CLOUD_COS_REGION=ap-guangzhou
TX_CLOUD_COS_SECRET_ID=your_secret_id
TX_CLOUD_COS_SECRET_KEY=your_secret_key
TX_CLOUD_COS_BUCKET=your-bucket-name

# 腾讯云短信配置
SMS_BASE_URL=https://sms.tencentcloudapi.com
SMS_KEY=your_sms_key
SMS_TPL_ID=your_template_id

# JWT 安全配置
ARIES_SECURITY_JWT_KEY_ID=your_key_id
ARIES_SECURITY_JWT_PUBLIC_KEY=your_public_key_content
ARIES_SECURITY_JWT_PRIVATE_KEY=your_private_key_content

# RSA 加密私钥
ARIES_SECURITY_RSA_PRIVATE_KEY=your_rsa_private_key_content

# 雪花算法配置
ARIES_SNOWFLAKE_WORKER_ID=1
ARIES_SNOWFLAKE_DATACENTER_ID=1
